    // ���Ч�� - ���ڵ����ܻ�ʱ���Ӿ�����
    hitEffect(x, y, color = '#fff', damage = 0) {
        // 50%����ʹ�û�����ͼ
        if (Math.random() < 0.5 && window.game && window.game.sprites) {
