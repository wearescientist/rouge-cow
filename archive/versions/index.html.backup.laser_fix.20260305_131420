                    const spreadAngle = (i - (burst - 1) / 2) * 0.1;
                    const fireAngle = baseAngle + spreadAngle;
                    bullets.push({
                        x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                        vx: Math.cos(fireAngle) * speed, vy: Math.sin(fireAngle) * speed,
