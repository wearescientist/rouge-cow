            }
        }
        
        // ���»�����
        this.updateOrbitals(dt, activeEnemies, stats);

        

        // v0.16.3: ���¾��鱦ʯ���������� + ��ȡ + ����ʰȡ��Χ��- ʹ�õ�ǰ�����gems
        if (!this.curRoom) return;
        for (let i = this.curRoom.gems.length - 1; i >= 0; i--) {
