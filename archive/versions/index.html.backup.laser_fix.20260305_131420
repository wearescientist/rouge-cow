        // ��ȡ�ȼ�����
        const tierConfig = {
            1: { name: '��ͨ', color: '#888888', glow: '#444444', particles: 0.2 },
            3: { name: 'ϡ��', color: '#4488ff', glow: '#2244aa', particles: 0.4 },
