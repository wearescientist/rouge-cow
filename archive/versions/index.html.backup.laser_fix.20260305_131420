        this.add(points, `��ɱ${enemyType === 'normal' ? '��ͨ��' : enemyType === 'elite' ? '��Ӣ' : 'Boss'}`);

    }

    

    // �����·���

    onEnterRoom() {

        this.stats.roomsExplored++;

        this.add(50, '̽���·���');

    }

    

    // ʰȡ����

    onCollectItem() {

        this.stats.itemsCollected++;

        this.add(50, 'ʰȡ����');

    }

    

    // ʰȡ���

    onCollectGold(amount) {

        this.stats.goldCollected += amount;

        this.add(amount, `ʰȡ${amount}���`);

    }

    

    // ����

    onDamage() {

        this.stats.damageTaken++;

        this.deduct(5, '����');  // ��΢�ͷ�����AI�и���ѧϰ����

    }

    

    // �����²�

    onFloorClear(floorNum) {

        this.stats.floorsCleared++;

        this.add(300, `ͨ�ص�${floorNum}��`);

    }

    

    // �����²㣨������

    onEnterFloor(floorNum) {

        this.onFloorClear(floorNum);

    }

    

    // ���ѽ�ң�����AI���

    onSpendGold(amount) {

        this.stats.goldSpent += amount;

        // ���ѽ�Ҽӷ֣����ѵ�50%��Ϊ������

        const bonus = Math.floor(amount * 0.5);

        this.add(bonus, `����${amount}��ҽ���`);

    }

    

    // ���ԭ��ͣ�������һ���

    checkStallPosition(playerX, playerY) {

        const now = Date.now();

        const dist = Math.sqrt((playerX - this.lastPosition.x) ** 2 + (playerY - this.lastPosition.y) ** 2);

        

        if (dist < 10) {

            // λ�û���û�䣬���ͣ��ʱ��

            const stallTime = Math.floor((now - this.lastPositionTime) / 1000);

            if (stallTime > 0 && stallTime % 30 === 0) {

                // ÿ30���һ�η�

                this.deduct(10, `ԭ��ͣ��${stallTime}��`);

            }

        } else {

            // λ�ñ仯�����ü�ʱ

            this.lastPosition = { x: playerX, y: playerY };

            this.lastPositionTime = now;

        }

    }

    

    // ����ظ����ʷ��䣨��ˢ�֣�

    checkRoomRevisit(roomId) {

        if (this.visitedRooms.has(roomId)) {

            // �ظ����ʿ۷�

            this.stats.roomsRevisited++;

            this.deduct(5, '�ظ����ʷ���');

            return true;

        } else {

            // �״η��ʣ���¼

            this.visitedRooms.add(roomId);

            return false;

        }

    }

    

    // ��Ϸ��������

    end(result) {

        this.isPlaying = false;

        this.endTime = Date.now();

        

        const playTime = (this.endTime - this.startTime) / 1000; // ��

        let finalScore = this.score;

        let multiplier = 1;

        

        // ͨ�ؼӳ�

        if (result === 'cleared') {

            multiplier = 1.5;

            

            // ���˼ӳ�

            if (this.stats.damageTaken === 0) {

                multiplier = 2.0;

                // v0.17.2: �Ƴ�������־
                // console.log('?? ����ͨ�أ�������2');

            }

            

            // ����ͨ��

            if (playTime < 300) { // 5����

                multiplier *= 1.5;

                // v0.17.2: �Ƴ�������־
                // console.log('? ����ͨ�أ������1.5');

            }

        }

        

        // �����ͷ�

        if (result === 'dead') {

            finalScore -= 500;

            // v0.17.2: �Ƴ�������־
            // console.log('?? �����ͷ� -500��');

        }

        

        finalScore = Math.floor(finalScore * multiplier);
        
        // ��¼��������ѧϰ����������-1000��ֹ����ֵ��
        if (finalScore < -1000) finalScore = -1000;

        

        // ���浽�������а�

        this.saveHighScore(finalScore, result);

        

        return {

            finalScore,

            baseScore: this.score,

            multiplier,

            playTime,

            stats: {...this.stats},

            result

        };

    }

    

    // ������߷�

    saveHighScore(score, result) {

        try {

            const key = 'rougecow_highscores';

            let scores = JSON.parse(localStorage.getItem(key) || '[]');

            scores.push({

                score,

                result,

                date: new Date().toISOString(),

                stats: {...this.stats}

            });

            scores.sort((a, b) => b.score - a.score);

            scores = scores.slice(0, 10); // ֻ����ǰ10

            localStorage.setItem(key, JSON.stringify(scores));

        } catch (e) {

            console.warn('�������а�ʧ��:', e);

        }

    }

    

    // ��ȡ���а�

    getHighScores() {

        try {

            return JSON.parse(localStorage.getItem('rougecow_highscores') || '[]');

        } catch (e) {

            console.warn('��ȡ���а�ʧ��:', e);

            return [];

        }

    }

    

    // ��ʽ����ʾ

    formatScore() {

        return this.score.toLocaleString();

    }

}



