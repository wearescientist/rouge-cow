                }
                return;
            }

            

            // v0.9.5 - ��������Ѫ������ (5%����)
            if (Math.random() < 0.05) {
                this.spawnHeartAt(this.curRoom.centerX + randInt(-50, 50), this.curRoom.centerY + randInt(-50, 50));
            }
            
            this.spawnRoomReward();
        }
        
        // Ѱ�����Ŀ�꣨�ӻ�Ծ�����У�

        let target = null, minD = 9999;

        for (const e of activeEnemies) {

            if (e.hp <= 0) continue;

            const d = dist(e.cx, e.cy, this.player.cx, this.player.cy);  // v0.16.3: ʹ�����ĵ�

            if (d < minD) { minD = d; target = e; }

        }

        

        // ���ԣ������˺�����״̬

        

            // �Ҵ���ģʽ�����������������ºͿ������������ڼ��ֹ����

        for (const w of this.weapons) {

            w.update(dt);

            // v0.22: ���������߼�
            // proj(Ͷ����)��instant(������)��ҪĿ����ܹ���
            // melee(��ս)����Ҳ��Ϊ��ҪĿ����ܹ���
            // aura(�⻷)/area(����)/orbit(����)������Ŀ�깥��
            const weaponType = w.cfg.type;
