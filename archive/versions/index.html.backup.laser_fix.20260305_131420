                        }
                    }
                    
                    if (b.life <= 0 && b.target) {
                        b.state = 'fire';
                        // v0.18.0: ʹ�õ������ĵ���㷽��
                        const targetCx = b.target.cx || b.target.x;
                        const targetCy = b.target.cy || (b.target.y - (b.target.size || 24));
                        const angle = Math.atan2(targetCy - b.y, targetCx - b.x);
