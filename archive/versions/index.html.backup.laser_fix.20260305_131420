    // ������ͣ�˵����

    handlePauseClick(e) {

        if (!this.paused || !this.pauseButtons) return;

        

        const rect = this.canvas.getBoundingClientRect();

        const x = e.clientX - rect.left;

        const y = e.clientY - rect.top;

        const cw = this.canvas.width || 900;

        

        this.pauseButtons.forEach(btn => {

            const btnX = cw / 2 - 120;

            const btnY = btn.y - 20;

            const btnW = 240;

            const btnH = 45;

            

            if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {

                this.executePauseButton(btn.id);

            }

        });

    }

    

    // ������ͣ�˵�����ƶ�����ͣЧ����

    handlePauseMouseMove(e) {

        if (!this.paused || !this.pauseButtons) return;

        

        const rect = this.canvas.getBoundingClientRect();

        const x = e.clientX - rect.left;

        const y = e.clientY - rect.top;

        const cw = this.canvas.width || 900;

        

        let hovered = null;

        this.pauseButtons.forEach(btn => {

            const btnX = cw / 2 - 120;

            const btnY = btn.y - 20;

            const btnW = 240;

            const btnH = 45;

            

            if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {

                hovered = btn.id;

            }

        });

        

        if (this.pauseHoverButton !== hovered) {

            this.pauseHoverButton = hovered;

            this.canvas.style.cursor = hovered ? 'pointer' : 'default';

        }

    }

    

