class HordeManager {

    constructor(room) {

        this.room = room;

        this.wave = 0;

        this.timer = 0;

        this.spawnedThisWave = 0;

        this.targetCount = 0;

        this.enemies = [];

        this.maxActiveEnemies = 80;

        

        // ���ݷ�����������ˢ�ֲ���

        this.setupRoomType();

        

        // ���ɱ�Եˢ�ֵ㣨�������������ˢ�֣�

        this.spawnPoints = this.generateSpawnPoints();

        

        // ������������ʼ��һ��

        if (this.totalWaves > 0) {

            this.startNewWave();

        }

    }

    

    // ���ݷ�����������

    setupRoomType() {

        const type = this.room.type;

        

        switch(type) {

            case 'normal':

                this.waveCount = 3 + Math.floor(Math.random() * 3); // 3-5��

                this.baseEnemyCount = 10; // ������������

                this.bossRoom = false;

                break;

            case 'boss':

                this.waveCount = 1;

                this.baseEnemyCount = 0;

                this.bossRoom = true;

                break;

            case 'hidden':

                this.waveCount = 1;

                this.baseEnemyCount = 6; // ������������

                this.bossRoom = false;

                this.eliteOnly = true;

                break;

            case 'elite':
                // ��Ӣ����3����ǰ����ȫT2��������15ֻT2+1ֻT3
                this.waveCount = 3;
                this.baseEnemyCount = 16; // ÿ��16ֻ��������
                this.bossRoom = false;
                this.eliteRoom = true; // ���Ϊ��Ӣ��
                break;

            default:

                this.waveCount = 0; // ���/�̵�/���䲻ˢ��

                this.baseEnemyCount = 0;

        }

        

        this.totalWaves = this.waveCount;

    }

    

    // ���ɱ�Եˢ�ֵ㣨�����ıߣ�����ǽһ�����룩

    generateSpawnPoints() {

        const points = [];

        const w = this.room.width;

        const h = this.room.height;

        const margin = 120; // ����ǽ�ľ���

        

        // ��������

        for (let x = margin; x < w - margin; x += 150) {

            points.push({x, y: margin});

            points.push({x, y: h - margin});

        }

        // ��������

        for (let y = margin; y < h - margin; y += 150) {

            points.push({x: margin, y});

            points.push({x: w - margin, y});

        }

        

        return points;

    }

    

    update(dt) {

        // ��������в���
        if (this.wave >= this.totalWaves && this.enemies.filter(e => e.hp > 0).length === 0) {
            // v0.18.0 fix: ������������cleared����Game.update()ͳһ���������߼�
            // ֻ���ţ�������Game.update()����
            this.openDoors();
            return;
        }

        

        // ��ǰ���ε������꣬������ʼ��һ��

        const activeCount = this.enemies.filter(e => e.hp > 0).length;

        if (activeCount === 0 && this.spawnedThisWave >= this.targetCount && this.wave < this.totalWaves) {

            this.startNewWave();

        }

        

        // ����ˢ��ֱ���ﵽ����Ŀ��

        if (this.spawnedThisWave < this.targetCount && activeCount < this.maxActiveEnemies) {

            this.spawnBatch();

        }

        

        this.enemies = this.enemies.filter(e => e.hp > 0);

    }

    

    startNewWave() {

        this.wave++;

        this.timer = 0;

        

        // �Ѷȹ�ʽ���������� �� (1 + ���� �� 0.2)

        const difficultyMultiplier = 1 + (this.wave - 1) * 0.2;

        this.targetCount = Math.floor(this.baseEnemyCount * difficultyMultiplier);

        this.spawnedThisWave = 0;

        

        // ���Ų��ο�ʼ��Ч����ͨ�����ҷǵ�һ����
        if (this.room.type === 'normal' && this.wave > 1) {
            window.game.audioCtrl.play('wave');
        }

        

        // v0.17.2: �Ƴ�������־������������

        // console.log(`?? �� ${this.wave}/${this.totalWaves} ����Ŀ�꣺${this.targetCount} ֻ`);

    }

    

    spawnBatch() {

        const batchSize = Math.min(3, this.targetCount - this.spawnedThisWave);

        const activeCount = this.enemies.filter(e => e.hp > 0).length;

        if (activeCount >= this.maxActiveEnemies) return;

        

        for (let i = 0; i < batchSize; i++) {

            if (this.spawnedThisWave >= this.targetCount) break;

            

            // ���ѡ��ˢ�ֵ�

            const point = this.spawnPoints[Math.floor(Math.random() * this.spawnPoints.length)];

            // �������ƫ��

            const x = point.x + (Math.random() - 0.5) * 60;

            const y = point.y + (Math.random() - 0.5) * 60;

            

            const enemy = this.createEnemy(x, y);

            this.enemies.push(enemy);

            this.spawnedThisWave++;

        }

    }

    

    createEnemy(x, y) {

        // ���ݲ���ѡ����˵ȼ�������
        const { typeKey, tier } = this.selectEnemyType();

        const enemy = new Enemy(x, y, typeKey, tier);

        

        // v0.18.4: Ӧ��¥���Ѷȱ��� - ��n��Ѫ����n
        const floor = window.game?.currentFloor || 1;
        const floorMultiplier = floor; // 2��=2��, 3��=3��, 6��=6��

        // Ӧ���Ѷ�����
        const waveMultiplier = 1 + (this.wave - 1) * 0.15; // HPÿ��+15%
        const dmgMultiplier = 1 + (this.wave - 1) * 0.08;  // �˺�ÿ��+8%
        const spdMultiplier = 1 + (this.wave - 1) * 0.03;  // �ٶ�ÿ��+3%

        // �ܱ��� = ¥�㱶�� �� ��������
        const totalHpMultiplier = floorMultiplier * waveMultiplier;

        enemy.hp = Math.floor(enemy.hp * totalHpMultiplier);
        enemy.maxHp = enemy.hp;
        enemy.dmg = Math.floor(enemy.dmg * dmgMultiplier);
        enemy.speed = Math.floor(enemy.speed * spdMultiplier);

        

        return enemy;

    }

    

    // v0.9.5 - ���ݲ����Ͳ���ѡ��������ͣ�4����ϵ
    // T1: ��ɫ��ͨ | T2: ��ɫ��Ӣ(�滻����: ����x10%, ���60%) | T3: ��ɫСBoss | T4: Boss
    selectEnemyType() {
        const floor = window.game?.currentFloor || 1;
        
        // v0.9.5 - T2��Ӣ���滻T1�ĸ���: ����30% + ����x5%�����70%
        // 1��: 35%, 2��: 40%, 3��: 45%, 4��: 50%, 5��: 55%, 6��+: 60%
        const t2ReplaceRate = Math.min(0.30 + (floor - 1) * 0.05, 0.60);
        
        // T1 ��ɫ��ͨ��
        const t1Types = ['chick', 'mouse', 'snail', 'pigeon', 'duck3', 'bat'];
        
        // T2 ��ɫ��Ӣ�� (�����ͷ���)
        const t2Types = {
            speed: ['rabbit2', 'bee', 'panther'],      // ��ɫ - �ٶ���
            tank: ['crab', 'nibei', 'bear'],           // ��ɫ - �����
            ranged: ['snake', 'goose', 'fox'],         // ��ɫ - ������
            assassin: ['tiaotiao', 'tiezhua', 'yinya'] // ��ɫ - �̿���
        };
        
        // T3 ��ɫСBoss
        const t3Types = ['wolf_king', 'turtle', 'mimic', 'ghost'];
        
        // ��Ӣ������6�����䣩- 3����ǰ����ȫT2��������15T2+1T3
        if (this.eliteRoom) {
            if (this.wave <= 2) {
                // ��1��2����ȫ��T2
                const t2Category = randChoice(Object.keys(t2Types));
                return { typeKey: randChoice(t2Types[t2Category]), tier: 2, eliteType: t2Category };
            } else {
                // ��3����ǰ15ֻT2�����1ֻT3
                const t2Count = this.enemies.filter(e => e.tier === 2 && e.hp > 0).length;
                const t3Count = this.enemies.filter(e => e.tier === 3 && e.hp > 0).length;
                // ����Ѿ���15ֻT2��û��T3������T3����������T2
                if (t2Count >= 15 && t3Count === 0) {
                    return { typeKey: randChoice(t3Types), tier: 3, isElite: true };
                } else {
                    const t2Category = randChoice(Object.keys(t2Types));
                    return { typeKey: randChoice(t2Types[t2Category]), tier: 2, eliteType: t2Category };
                }
            }
        }
        
        // ��Ӣ�����ض�����
        if (this.eliteOnly) {
            // ��Ӣ��: 1��T3 + 2��T2
            const isT3 = this.enemies && this.enemies.filter(e => e.hp > 0).length === 0;
            if (isT3) {
                return { typeKey: randChoice(t3Types), tier: 3, isElite: true };
            }
            // ���ѡ��T2����
            const t2Category = randChoice(Object.keys(t2Types));
            return { typeKey: randChoice(t2Types[t2Category]), tier: 2, eliteType: t2Category };
        }
        
        // Boss��
        if (this.bossRoom && this.wave === 1) {
            return { typeKey: 'mother', tier: 4, isBoss: true };
        }
        
        // ��ͨ����: ����T2�滻���ʾ���
        const roll = Math.random();
        
        if (roll < t2ReplaceRate) {
            // ����T2��Ӣ��
            const t2Category = randChoice(Object.keys(t2Types));
            return { typeKey: randChoice(t2Types[t2Category]), tier: 2, eliteType: t2Category };
        }
        
        // ����T1��ͨ��
        return { typeKey: randChoice(t1Types), tier: 1 };
    }
    

    openDoors() {

        Object.values(this.room.doors).forEach(door => {

            if (door) {

                door.open = true;

                door.locked = false;

            }

        });

        // v0.17.2: �Ƴ�������־
        // console.log('?? ����������ɣ����ѿ���');

    }

    

    getActiveEnemies() {

        return this.enemies.filter(e => e.hp > 0);

    }

}



// ��ͼ������

class MapGenerator {

    generate(floor = 1) {

        const rooms = new Map();

        const start = new Room(0, 0, 'start', floor);

        rooms.set(start.id, start);

        

        const queue = [start];

        const dirs = [

            { dx: 0, dy: -1, name: 'up', opp: 'down' },

            { dx: 1, dy: 0, name: 'right', opp: 'left' },

            { dx: 0, dy: 1, name: 'down', opp: 'up' },

            { dx: -1, dy: 0, name: 'left', opp: 'right' }

        ];

        

        let count = 1;

        const maxRooms = 8 + floor * 2;

        

        while (queue.length && count < maxRooms) {

            const cur = queue.shift();

            for (const dir of dirs.sort(() => Math.random() - 0.5)) {

                const nx = cur.gx + dir.dx, ny = cur.gy + dir.dy;

                const id = `${floor}_${nx},${ny}`;

                

                if (rooms.has(id)) {

                    const ex = rooms.get(id);

                    if (!cur.doors[dir.name]) {

                        cur.doors[dir.name] = { open: cur.cleared, target: ex };

                        ex.doors[dir.opp] = { open: ex.cleared, target: cur };

                    }

                    continue;

                }

                

                if (Math.random() > 0.4 || count < 5) {

                    let type = 'normal';

                    if (count === maxRooms - 1) {
                        // ���һ�����䣺Boss��
                        type = 'boss';
                    } else if (count === 5) {
                        // ��5������̶�Ϊ���䷿
                        type = 'treasure';
                    } else if (count === 6) {
                        // ��6������̶�Ϊ��Ӣ��
                        type = 'elite';
                    } else if (count === 7) {
                        // ��7������̶�Ϊ�̵귿
                        type = 'shop';
                    }

                    

                    const nr = new Room(nx, ny, type, floor);

                    cur.doors[dir.name] = { open: cur.cleared, target: nr };

                    nr.doors[dir.opp] = { open: nr.cleared, target: cur };

                    rooms.set(id, nr);

                    queue.push(nr);

                    count++;

                }

            }

        }

        

        // �޸���ȷ���������ڷ��䶼��˫��������

        this.fixDoorConnections(rooms);
        
        // ȷ��ÿ��������1���̵��1������
        this.ensureSpecialRooms(rooms, start);

        

        return { start, rooms };

    }

    

    // �޸������ӣ�ȷ�����ڷ��䶼��˫����

    fixDoorConnections(rooms) {

        const dirs = [

            { dx: 0, dy: -1, name: 'up', opp: 'down' },

            { dx: 1, dy: 0, name: 'right', opp: 'left' },

            { dx: 0, dy: 1, name: 'down', opp: 'up' },

            { dx: -1, dy: 0, name: 'left', opp: 'right' }

        ];

        

        for (const room of rooms.values()) {

            for (const dir of dirs) {

                const nx = room.gx + dir.dx;

                const ny = room.gy + dir.dy;

                // ����ʹ�ô� floor �ļ��������������ʹ�ñ��ü�
                let neighborId = `${room.floor}_${nx},${ny}`;
                if (!rooms.has(neighborId)) {
                    neighborId = `${nx},${ny}`;
                }

                

                if (rooms.has(neighborId)) {

                    const neighbor = rooms.get(neighborId);

                    // �����ǰ����û�����������ţ�����һ��

                    if (!room.doors[dir.name]) {

                        room.doors[dir.name] = { 

                            open: room.cleared, 

                            target: neighbor 

                        };

                    }

                    // ������ڷ���û�з�����ţ�����һ��

                    if (!neighbor.doors[dir.opp]) {

                        neighbor.doors[dir.opp] = { 

                            open: neighbor.cleared, 

                            target: room 

                        };

                    }

                }

            }

        }

    }
    
    // ȷ��ÿ��������1���̵��1������
    ensureSpecialRooms(rooms, start) {
        const roomList = Array.from(rooms.values());
        
        // ����Ƿ������̵�ͱ���
        const hasShop = roomList.some(r => r.type === 'shop');
        const hasTreasure = roomList.some(r => r.type === 'treasure');
        
        // ��ȡ����㡢��boss����ͨ�����б�
        const normalRooms = roomList.filter(r => 
            r.type === 'normal' && 
            r !== start && 
            !r.bossRoom
        );
        
        // ���û�б��䣬����һ����ͨ����Ϊ���䷿
        if (!hasTreasure && normalRooms.length > 0) {
            normalRooms[0].type = 'treasure';
            normalRooms[0].cleared = true;
