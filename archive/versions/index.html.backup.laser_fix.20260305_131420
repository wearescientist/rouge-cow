    // ���ɳ齱����
    generateLotteryWeapons() {
        const lottery = this.bossChestLottery;
        lottery.revealedWeapons = [];
        
        // ��ȡ��������������������ʣ���������������
        let upgradableWeapons = [];
        for (const w of this.weapons) {
            if (!w.isSuper && w.canLevelUp()) {
                const maxLv = WEAPONS[w.baseKey]?.maxLevel || 8;
                const remainingUpgrades = maxLv - w.level;
                upgradableWeapons.push({
                    key: w.baseKey,
                    remaining: remainingUpgrades,
                    weapon: w
                });
            }
        }
        
        // ��ȡδӵ�е��������أ����������ԭ������
        const ownedKeys = new Set();
        for (const w of this.weapons) {
            if (w.isSuper) {
                ownedKeys.add(w.baseKey);
                if (w.originKey) ownedKeys.add(w.originKey);
            } else {
                ownedKeys.add(w.baseKey);
            }
        }
        const newWeaponPool = Object.keys(WEAPONS).filter(key => !ownedKeys.has(key));
        
        // ������������������������������������ʣ���������
        let remainingSlots = lottery.resultTier;
        
        // ��һ�������ȸ�����������������������������ʣ������������
        // ʹ��expectedLevel������ÿ�������ڳ齱�е�Ԥ�ڵȼ������޸���ʵ������
        upgradableWeapons.forEach(u => u.expectedLevel = u.weapon.level);
        
        while (remainingSlots > 0 && upgradableWeapons.length > 0) {
            // ��ʣ������������Ӷൽ���������ȸ��ܶ������������
            upgradableWeapons.sort((a, b) => b.remaining - a.remaining);
            
            const upgradeInfo = upgradableWeapons[0];
            const currentLv = upgradeInfo.expectedLevel;
            
            lottery.revealedWeapons.push({
                key: upgradeInfo.key,
                data: WEAPONS[upgradeInfo.key],
                revealed: false,
                isUpgrade: true,
                currentLevel: currentLv,
                y: 300 + (lottery.resultTier - remainingSlots) * 80,
                targetY: 200 + (lottery.resultTier - remainingSlots) * 90,
                scale: 0,
                rotation: 0
            });
            
            remainingSlots--;
            upgradeInfo.remaining--;
            upgradeInfo.expectedLevel++; // ����Ԥ�ڵȼ�����һ��ͬ��������ʾ���ߵȼ�
            
            // ������������޷������������б��Ƴ�
            if (upgradeInfo.remaining <= 0) {
                upgradableWeapons.shift();
            }
        }
        
        // �ڶ�����ʣ�������������
        while (remainingSlots > 0) {
            let weaponKey;
            
            if (newWeaponPool.length > 0) {
                // �������������ѡһ��
                const idx = Math.floor(Math.random() * newWeaponPool.length);
                weaponKey = newWeaponPool[idx];
                // ѡ���Ĵӳ����Ƴ�������һ�γ齱���ظ���δӵ��������
                newWeaponPool.splice(idx, 1);
            } else {
                // û���������ˣ������������������ת��Ϊ��һ��ظ���ʾ��
                const allKeys = Object.keys(WEAPONS);
                weaponKey = allKeys[Math.floor(Math.random() * allKeys.length)];
            }
            
            lottery.revealedWeapons.push({
                key: weaponKey,
                data: WEAPONS[weaponKey],
                revealed: false,
                isUpgrade: false,
                y: 300 + (lottery.resultTier - remainingSlots) * 80,
                targetY: 200 + (lottery.resultTier - remainingSlots) * 90,
                scale: 0,
                rotation: 0
            });
            
            remainingSlots--;
        }
    }
    
