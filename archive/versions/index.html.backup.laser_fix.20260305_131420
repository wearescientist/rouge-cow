        if (canvas) {

            canvas.addEventListener('mousedown', e => {

                const rect = canvas.getBoundingClientRect();

                const scaleX = canvas.width / rect.width;

                const scaleY = canvas.height / rect.height;

                this.mouseX = (e.clientX - rect.left) * scaleX;

                this.mouseY = (e.clientY - rect.top) * scaleY;

                this.mouseDown = true;

                this.handleClick(this.mouseX, this.mouseY);

            });

            

            canvas.addEventListener('mouseup', () => {

                this.mouseDown = false;

            });

            

            canvas.addEventListener('mousemove', e => {

                const rect = canvas.getBoundingClientRect();

                const scaleX = canvas.width / rect.width;

                const scaleY = canvas.height / rect.height;

                this.mouseX = (e.clientX - rect.left) * scaleX;

                this.mouseY = (e.clientY - rect.top) * scaleY;

                

                // v0.22.1: ��ͣ�˵���ͣЧ��

                if (this.paused) {

                    this.handlePauseMouseMove(e);

                }

            });

            

            // ��������֧�֣��ƶ��豸��

            canvas.addEventListener('touchstart', e => {

                e.preventDefault();

                const touch = e.touches[0];

                const rect = canvas.getBoundingClientRect();

                const scaleX = canvas.width / rect.width;

                const scaleY = canvas.height / rect.height;

                this.mouseX = (touch.clientX - rect.left) * scaleX;

                this.mouseY = (touch.clientY - rect.top) * scaleY;

                this.mouseDown = true;

                this.handleClick(this.mouseX, this.mouseY);

            }, { passive: false });

            

            canvas.addEventListener('touchmove', e => {

                e.preventDefault();

                const touch = e.touches[0];

                const rect = canvas.getBoundingClientRect();

                const scaleX = canvas.width / rect.width;

                const scaleY = canvas.height / rect.height;

                this.mouseX = (touch.clientX - rect.left) * scaleX;

                this.mouseY = (touch.clientY - rect.top) * scaleY;

            }, { passive: false });

            

            canvas.addEventListener('touchend', e => {

                e.preventDefault();

                this.mouseDown = false;

            }, { passive: false });

            

        }

    }

    

    // ��������¼�

    handleClick(x, y) {
        // v0.22.1: ��ͣ�˵��������
        if (this.paused) {
            this.handlePauseClick({ clientX: x + this.canvas.getBoundingClientRect().left, clientY: y + this.canvas.getBoundingClientRect().top });
            return;
        }
        
        // v0.22: ͨ�ؾ������л�
        if (this.credits && this.credits.active) {
            this.advanceCredits();
            return;
        }

        // v0.22: �������UI���ڲ���Ϊ�����
        const clickedUI = this.detectClickedUI(x, y);
        if (clickedUI) {
            this.activeUIWindow = clickedUI;
        }

        // ���㻭��������

        if (this.showResultScreen) {

            // ʹ�ñ���İ�ť������м��

            const btn = this.resultBtnRect;

            if (btn && x > btn.x && x < btn.x + btn.w && y > btn.y && y < btn.y + btn.h) {

                this.returnToMainMenu();

            }

            return;

        }

        

        // ����ѡ�������������4ѡ1��

        if (this.levelUpOpen) {

            const canvas = document.getElementById('gameCanvas');

            if (!canvas) return;

            const cw = canvas.width;

            const ch = canvas.height;

            

            // �����ĸ�ѡ���λ�ã�2x2����

            const boxWidth = 560;

            const boxHeight = 400;

            const boxX = (cw - boxWidth) / 2;

            const boxY = (ch - boxHeight) / 2;

            const cardWidth = 240;

            const cardHeight = 150;

            const gapX = 40;

            const gapY = 30;

            const startX = boxX + (boxWidth - 2 * cardWidth - gapX) / 2 + cardWidth / 2;

            const startY = boxY + 100 + cardHeight / 2;

            

            for (let i = 0; i < 4; i++) {

                const row = Math.floor(i / 2);

                const col = i % 2;

                const cx = startX + col * (cardWidth + gapX);

                const cy = startY + row * (cardHeight + gapY);

                if (x > cx - cardWidth/2 && x < cx + cardWidth/2 &&

                    y > cy - cardHeight/2 && y < cy + cardHeight/2) {

                    this.selectLevelUpOption(i);

                    return;

                }

            }

            return;

        }

        

        // �̵����������

        if (this.shopOpen) {

            const canvas = document.getElementById('gameCanvas');

            if (!canvas) return;

            const cw = canvas.width || 900;

            const ch = canvas.height || 600;

            const centerX = cw / 2;

            const centerY = ch / 2;

            

            // �� drawShopUI ��ȫһ�µ�����

            const boxWidth = 500;

            const boxHeight = 350;

            const boxX = centerX - boxWidth / 2;

            const boxY = centerY - boxHeight / 2;

            const itemWidth = 130;

            const itemHeight = 160;

            const startX = centerX - (this.shopItems.length * itemWidth) / 2 + itemWidth / 2;

            const itemY = boxY + 160;

            

            // ����Ƿ����ڹر����򣨵�������رգ�

            if (x < boxX || x > boxX + boxWidth || y < boxY || y > boxY + boxHeight) {

                this.closeShop();

                return;

            }

            

            for (let i = 0; i < this.shopItems.length; i++) {

                const ix = startX + i * (itemWidth + 20);

                if (x > ix - itemWidth/2 && x < ix + itemWidth/2 &&

                    y > itemY - itemHeight/2 && y < itemY + itemHeight/2) {

                    this.buyItem(i);

                    return;

                }

            }

            return;
        }
        
        // ����ѡ���������
        if (this.chestOpen) {
            const canvas = document.getElementById('gameCanvas');
            if (!canvas) return;
            const cw = canvas.width || 900;
            const ch = canvas.height || 600;
            const centerX = cw / 2;
            const centerY = ch / 2;
            
            const boxWidth = 560;
            const boxHeight = 320;
            const boxX = centerX - boxWidth / 2;
            const boxY = centerY - boxHeight / 2;
            
            // ��������ر�
            if (x < boxX || x > boxX + boxWidth || y < boxY || y > boxY + boxHeight) {
                this.closeChestSelect();
                return;
            }
            
            const itemWidth = 150;
            const itemHeight = 180;
            const startX = centerX - (this.chestItems.length * itemWidth) / 2 + itemWidth / 2;
            const iy = boxY + 150;
            
            for (let i = 0; i < this.chestItems.length; i++) {
                const ix = startX + i * (itemWidth + 20);
                if (x > ix - itemWidth/2 && x < ix + itemWidth/2 &&
                    y > iy - itemHeight/2 && y < iy + itemHeight/2) {
                    this.selectChestItem(i);
                    return;
                }
            }
            return;
        }
        
        // ������ѡ���������
        if (this.weaponBoxOpen) {
            const canvas = document.getElementById('gameCanvas');
            if (!canvas) return;
            const cw = canvas.width || 900;
            const ch = canvas.height || 600;
            const centerX = cw / 2;
            const centerY = ch / 2;
            
            const boxWidth = 600;
            const boxHeight = 340;
            const boxX = centerX - boxWidth / 2;
            const boxY = centerY - boxHeight / 2;
            
            // ��������ر�
            if (x < boxX || x > boxX + boxWidth || y < boxY || y > boxY + boxHeight) {
                this.closeWeaponBoxSelect();
                return;
            }
            
            const itemWidth = 160;
            const itemHeight = 200;
            const startX = centerX - (this.weaponBoxOptions.length * itemWidth) / 2 + itemWidth / 2;
            const iy = boxY + 160;
            
            for (let i = 0; i < this.weaponBoxOptions.length; i++) {
                const ix = startX + i * (itemWidth + 20);
                if (x > ix - itemWidth/2 && x < ix + itemWidth/2 &&
                    y > iy - itemHeight/2 && y < iy + itemHeight/2) {
                    this.selectWeaponBoxOption(i);
                    return;
                }
            }
            return;
        }
        
        // ?? ��ɫBoss����齱�������
        if (this.bossChestLottery && this.bossChestLottery.active) {
            // ֻ����ɽ׶β��ܵ���ر�
            if (this.bossChestLottery.phase === 'done') {
                this.closeBossChestLottery();
            }
            return;
        }
    }

    // v0.22: ����������ĸ�UI����
    detectClickedUI(x, y) {
        const canvas = document.getElementById('gameCanvas');
        if (!canvas) return null;
        
        const cw = canvas.width || 900;
        const ch = canvas.height || 600;
        
        // ������˳�����⣨����Ƶ��ȼ�⣩
        // ������
        if (this.weaponBoxOpen) {
            const boxWidth = 600;
            const boxHeight = 300;
            const boxX = (cw - boxWidth) / 2;
            const boxY = (ch - boxHeight) / 2 + 50;
            if (x >= boxX && x <= boxX + boxWidth && y >= boxY && y <= boxY + boxHeight) {
                return 'weaponBox';
            }
        }
        
        // ����
        if (this.chestOpen) {
            const boxWidth = 500;
            const boxHeight = 280;
            const boxX = (cw - boxWidth) / 2;
            const boxY = (ch - boxHeight) / 2 + 50;
            if (x >= boxX && x <= boxX + boxWidth && y >= boxY && y <= boxY + boxHeight) {
                return 'chest';
            }
        }
        
        // ����ѡ��
        if (this.levelUpOpen) {
            const boxWidth = 560;
            const boxHeight = 400;
            const boxX = (cw - boxWidth) / 2;
            const boxY = (ch - boxHeight) / 2;
            if (x >= boxX && x <= boxX + boxWidth && y >= boxY && y <= boxY + boxHeight) {
                return 'levelUp';
            }
        }
        
        // �̵�
        if (this.shopOpen) {
            const boxWidth = 500;
            const boxHeight = 350;
            const boxX = (cw - boxWidth) / 2;
            const boxY = (ch - boxHeight) / 2;
            if (x >= boxX && x <= boxX + boxWidth && y >= boxY && y <= boxY + boxHeight) {
                return 'shop';
            }
        }
        
        return null;
    }

    // ��Ѫ���Ҵ��߷��4ѡ1����ѡ����棨2����+2������
    openLevelUpSelect() {
        this.levelUpOpen = true;
        this.activeUIWindow = 'levelUp'; // v0.22: ��Ϊ�����
        this.levelUpOptions = [];
        
        // ������Ч - v0.16.3: ʹ�����ĵ�
        this.particles.explosion(this.player.cx, this.player.cy, '#ff0', 40);
        this.particles.sparkle(this.player.cx, this.player.cy, '#fff', 15);
        
        // ����2������ѡ��
        // ����ѡ����ӵ�е�δ����������
        const ownedWeapons = this.weapons.filter(w => !w.isSuper && w.canLevelUp()).map(w => w.baseKey);
        
        // ��ȡ��ӵ�е�����key�����������ԭ������
        const ownedKeys = new Set();
        for (const w of this.weapons) {
            if (w.isSuper) {
                // ���䣺��¼���䱾����ԭ����
                ownedKeys.add(w.baseKey);
                if (w.originKey) ownedKeys.add(w.originKey);
            } else {
                ownedKeys.add(w.baseKey);
            }
        }
        
        const availableNewWeapons = Object.keys(WEAPONS).filter(key => {
            return !ownedKeys.has(key); // �ų���ӵ�еģ���������ԭ������
        });
        
        // ��һ������������ѡ��ӵ�еģ�����У�
        if (ownedWeapons.length > 0) {
            const key = ownedWeapons[Math.floor(Math.random() * ownedWeapons.length)];
            const existing = this.weapons.find(w => w.baseKey === key);
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: false,
                level: existing.level + 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
            // ��ownedWeapons���Ƴ���ѡ���
            const idx = ownedWeapons.indexOf(key);
            if (idx > -1) ownedWeapons.splice(idx, 1);
        } else if (availableNewWeapons.length > 0) {
            // û����ӵ�е�������ѡ������
            const idx = Math.floor(Math.random() * availableNewWeapons.length);
            const key = availableNewWeapons.splice(idx, 1)[0];
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: true,
                level: 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
        }
        
        // �ڶ�����������ʣ��Ŀ���������ѡ
        const remainingWeapons = [...ownedWeapons, ...availableNewWeapons];
        if (remainingWeapons.length > 0) {
            const idx = Math.floor(Math.random() * remainingWeapons.length);
            const key = remainingWeapons.splice(idx, 1)[0];
            const existing = this.weapons.find(w => w.baseKey === key);
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: !existing,
                level: existing ? existing.level + 1 : 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
        }
        
        // ����2������ѡ���ʾ�����ĸ������ϳɳ���
        const availablePassives = Object.keys(PASSIVES).filter(key => {
            const level = this.passives.getLevel(key);
            const maxLevel = PASSIVES[key].maxLevel;
            return level < maxLevel; // δ�����ı���
        });
        
        // ���ұ�����Ӧ�ĳ���ϳ���Ϣ - v0.17.1 fix: ���Ӱ�ȫУ��
        const getSuperWeaponInfo = (passiveKey) => {
            for (const [weaponKey, evo] of Object.entries(WEAPON_EVOLUTIONS)) {
                if (evo.requires === passiveKey) {
                    const weapon = this.weapons.find(w => w.baseKey === weaponKey && !w.isSuper);
                    // v0.17.1 fix: ������������Ƿ����
                    const weaponCfg = WEAPONS[weaponKey];
                    if (!weaponCfg) {
                        console.warn(`[getSuperWeaponInfo] Weapon ${weaponKey} not found in WEAPONS`);
                        continue;
                    }
                    return {
                        weaponName: weaponCfg.name,
                        superName: evo.name,
                        owned: !!weapon,
                        level: weapon ? weapon.level : 0,
                        canEvolve: weapon && weapon.level >= 8
                    };
                }
            }
            return null;
        };
        
        for (let i = 0; i < 2 && availablePassives.length > 0; i++) {
            const idx = Math.floor(Math.random() * availablePassives.length);
            const key = availablePassives.splice(idx, 1)[0];
            const currentLevel = this.passives.getLevel(key);
            const superInfo = getSuperWeaponInfo(key);
            
            this.levelUpOptions.push({
                type: 'passive',
                key: key,
                level: currentLevel + 1,
                maxLevel: PASSIVES[key].maxLevel,
                superInfo: superInfo,
                data: PASSIVES[key]

            });

        }

        

        // v0.17.2: �Ƴ�������־
        // console.log('����ѡ������Ѵ�', this.levelUpOptions);

    }

    

