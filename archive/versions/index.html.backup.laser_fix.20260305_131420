        // v0.16.1 fix: ȷ���˺�Ϊ��Ч����
        let totalDmg = (typeof dmg === 'number' && dmg > 0) ? dmg : 1;
        
        // v0.16.1 fix: �˺��ӳɸ�Ϊ�ٷֱ���ʽ
        if (stats && stats.fireDmg) totalDmg *= (1 + stats.fireDmg);
        if (stats && stats.thunderDmg && Math.random() < 0.3) totalDmg *= (1 + stats.thunderDmg);
        
        // ȷ���˺�Ϊ����
        totalDmg = Math.floor(totalDmg);
        
        const killed = e.takeDamage(totalDmg, stats || {});
        
        if (stats && stats.poisonDmg && e.applyPoison) e.applyPoison(stats.poisonDmg, 3);
        // v0.18.4 fix: ����healOnHitЧ��
        if (stats && stats.healOnHit && this.player) {
            this.player.hp = Math.min(this.player.maxHp, this.player.hp + stats.healOnHit);
        }
        // v0.18.4 fix: ����lifeStealЧ������������˺���Ѫ��
        if (stats && stats.lifeSteal && this.player && totalDmg > 0) {
            const healAmount = Math.floor(totalDmg * stats.lifeSteal);
            if (healAmount > 0) {
                this.player.hp = Math.min(this.player.maxHp, this.player.hp + healAmount);
            }
        }
        
        if (killed) {
            e.hp = 0;

            // v0.16.3: ���й�������������߱�ըЧ��
            this.spawnExplosiveDrops(e);
            
            // v0.17.4 fix: Boss (isBoss/tier 4) �� T3 СBoss ������
