const SURVIVOR_CONFIG = {

    VIEW_WIDTH: 960, VIEW_HEIGHT: 960,

    CAMERA_SMOOTH: 0.1,

    WAVE_INTERVAL: 30, WAVE_BASE_COUNT: 20, WAVE_INCREMENT: 5,

    GRID_CELL_SIZE: 150,

    // ����Ӧ��Ұ�������Ļ�������ʾ��������

    ADAPTIVE_VIEW: true,

    // ����ߴ磺���������ɼӺ�ǽ
    ROOM_WIDTH: 2000,
    ROOM_HEIGHT: 2000,
    
    // ǽ��ȣ������Ը�����ʾ��
    WALL_THICKNESS: 120,
    
    // �ذ�����߽磨�ų�ǽ������
    get floorLeft() { return this.WALL_THICKNESS; },
    get floorTop() { return this.WALL_THICKNESS; },
    get floorRight() { return this.ROOM_WIDTH - this.WALL_THICKNESS; },
    get floorBottom() { return this.ROOM_HEIGHT - this.WALL_THICKNESS; },
    
    // ��������ȣ�����������������ľ��룩
    DOOR_WIDTH_HALF: 40,
    DOOR_HEIGHT_HALF: 30,
    
    // ���λ���Ƿ�����Ч�����ڣ��ذ�+�ţ�
    isInValidArea(x, y, room) {
        const centerX = this.ROOM_WIDTH / 2;
        const centerY = this.ROOM_HEIGHT / 2;
        const doorWH = this.DOOR_WIDTH_HALF;
        const doorHH = this.DOOR_HEIGHT_HALF;
        
        // ���ȼ���Ƿ��ڵذ�������
        const inFloor = x >= this.floorLeft && x <= this.floorRight && 
                        y >= this.floorTop && y <= this.floorBottom;
        if (inFloor) return true;
        
        // ������ڵذ��ڣ�����Ƿ����κο��ŵ���������
        if (!room || !room.doors) return false;
        
        const doors = room.doors;
        
        // �����
        if (doors.left && doors.left.open) {
            if (x < this.floorLeft && y > centerY - doorWH && y < centerY + doorWH) return true;
        }
        // �Ҳ���
        if (doors.right && doors.right.open) {
            if (x > this.floorRight && y > centerY - doorWH && y < centerY + doorWH) return true;
        }
        // �ϲ���
        if (doors.up && doors.up.open) {
            if (y < this.floorTop && x > centerX - doorHH && x < centerX + doorHH) return true;
        }
        // �²���
        if (doors.down && doors.down.open) {
            if (y > this.floorBottom && x > centerX - doorHH && x < centerX + doorHH) return true;
        }
        
        return false;
    },
    
    // ��λ����������Ч������
    clampToValidArea(x, y, room) {
        const centerX = this.ROOM_WIDTH / 2;
        const centerY = this.ROOM_HEIGHT / 2;
        const doorWH = this.DOOR_WIDTH_HALF;
        const doorHH = this.DOOR_HEIGHT_HALF;
        
        // ����Ѿ�����Ч�����ڣ�ֱ�ӷ���
        if (this.isInValidArea(x, y, room)) return { x, y };
        
        // �������Ƶ��ذ�����
        let clampedX = clamp(x, this.floorLeft, this.floorRight);
        let clampedY = clamp(y, this.floorTop, this.floorBottom);
        
        // ������ƺ�λ����Ȼ������Ч���򣨿����ڽ��䣩�����������
        if (!this.isInValidArea(clampedX, clampedY, room)) {
            // ����ĸ�����������Խ���������
            if (room && room.doors) {
                const doors = room.doors;
                
                // ���
                if (doors.left && doors.left.open && x < this.floorLeft && Math.abs(y - centerY) < doorWH) {
                    clampedX = this.floorLeft;
                    clampedY = clamp(y, centerY - doorWH, centerY + doorWH);
                }
                // �Ҳ�
                else if (doors.right && doors.right.open && x > this.floorRight && Math.abs(y - centerY) < doorWH) {
                    clampedX = this.floorRight;
                    clampedY = clamp(y, centerY - doorWH, centerY + doorWH);
                }
                // �ϲ�
                else if (doors.up && doors.up.open && y < this.floorTop && Math.abs(x - centerX) < doorHH) {
                    clampedX = clamp(x, centerX - doorHH, centerX + doorHH);
                    clampedY = this.floorTop;
                }
                // �²�
                else if (doors.down && doors.down.open && y > this.floorBottom && Math.abs(x - centerX) < doorHH) {
                    clampedX = clamp(x, centerX - doorHH, centerX + doorHH);
                    clampedY = this.floorBottom;
                }
            }
        }
        
        return { x: clampedX, y: clampedY };
    }

};



class SurvivorCamera {

    constructor() {

        this.x = SURVIVOR_CONFIG.ROOM_WIDTH / 2;

        this.y = SURVIVOR_CONFIG.ROOM_HEIGHT / 2;

        this.target = null;

        this.viewWidth = SURVIVOR_CONFIG.VIEW_WIDTH;

        this.viewHeight = SURVIVOR_CONFIG.VIEW_HEIGHT;

        this.showFullRoom = true;  // Ĭ����ʾ��������

        this.zoom = 1;

        // ��Ļ�𶯲���

        this.shake = 0;

        this.shakeDecay = 0.9;

        // ���ڹ��캯���е���updateViewport���ȴ�Game.init����

    }
    
    // ������Ļ��
    addShake(amount) {
        this.shake = Math.max(this.shake, amount);
    }

    

    // ���ݴ��ڳߴ����÷����С��ȷ������������ʾ��������Ϸ����

    updateViewport() {

        // ��ȡ�����ߴ�

        const container = document.getElementById('centerGame');

        let maxSize = 960; // Ĭ�����ߴ�

        if (container) {

            const rect = container.getBoundingClientRect();

            // ���������Σ�ȡ��С�ı���Ϊ�ߴ�

            maxSize = Math.min(rect.width, rect.height, 960);

        }

        // ȷ����С����С�ߴ�

        const canvasW = Math.max(600, Math.floor(maxSize));

        const canvasH = canvasW; // ������

        

        const canvas = document.getElementById('gameCanvas');

        if (canvas) {

            canvas.width = canvasW;

            canvas.height = canvasH;

            // ���� canvas ��ʽ�ߴ�

            canvas.style.width = canvasW + 'px';

            canvas.style.height = canvasH + 'px';

        }

        

        // ��Ұ���� canvas ��С����

        SURVIVOR_CONFIG.VIEW_WIDTH = canvasW;

        SURVIVOR_CONFIG.VIEW_HEIGHT = canvasH;

        
        // �����С�� SURVIVOR_CONFIG ���壬��Ұ����Ӧ�����������ʾ��������

        

        const roomW = SURVIVOR_CONFIG.ROOM_WIDTH;

        const roomH = SURVIVOR_CONFIG.ROOM_HEIGHT;

        

        // ʼ����ʾ��������

        this.showFullRoom = true;

        this.viewWidth = roomW;

        this.viewHeight = roomH;

        this.x = roomW / 2;

        this.y = roomH / 2;

        this.zoom = 1;

        

        // v0.17.2: �Ƴ�������־
        // console.log(`?? ����ߴ�: ${roomW}x${roomH}, Canvas: ${canvasW}x${canvasH}`);

    }

    

    follow(target) { this.target = target; }

    

    update() {

        // ������Ļ��˥��

        if (this.shake > 0.1) {

            this.shake *= this.shakeDecay;

        } else {

            this.shake = 0;

        }

        if (this.showFullRoom) {

            // ��ʾ��������ʱ������̶������ģ�������ƫ�ƣ�

            this.x = SURVIVOR_CONFIG.ROOM_WIDTH / 2 + (Math.random() - 0.5) * this.shake;

            this.y = SURVIVOR_CONFIG.ROOM_HEIGHT / 2 + (Math.random() - 0.5) * this.shake;

            return;

        }

        

        if (!this.target) return;

        this.x += (this.target.x - this.x) * SURVIVOR_CONFIG.CAMERA_SMOOTH;

        this.y += (this.target.y - this.y) * SURVIVOR_CONFIG.CAMERA_SMOOTH;

        const minX = this.viewWidth / 2, maxX = SURVIVOR_CONFIG.ROOM_WIDTH - this.viewWidth / 2;

        const minY = this.viewHeight / 2, maxY = SURVIVOR_CONFIG.ROOM_HEIGHT - this.viewHeight / 2;

        this.x = Math.max(minX, Math.min(maxX, this.x));

        this.y = Math.max(minY, Math.min(maxY, this.y));

    }

    

    worldToScreen(wx, wy) {

        if (this.showFullRoom) {

            // ��������ģʽ�����ŷ�������Ӧ canvas�����������ɼ�

            const canvas = document.getElementById('gameCanvas');

            const canvasW = canvas ? canvas.width : 960;

            const canvasH = canvas ? canvas.height : 960;

            const roomW = SURVIVOR_CONFIG.ROOM_WIDTH;

            const roomH = SURVIVOR_CONFIG.ROOM_HEIGHT;

            
            // �������ű���
            const scale = Math.min(canvasW / roomW, canvasH / roomH);
            
            // �������ƫ��
            const offsetX = (canvasW - roomW * scale) / 2;
            const offsetY = (canvasH - roomH * scale) / 2;

            return { 
                x: wx * scale + offsetX, 
                y: wy * scale + offsetY,
                scale: scale
            };

        }

        // ��ͨģʽ��Ӧ�����λ�� + ��ƫ��
        const shakeX = this.shake > 0 ? (Math.random() - 0.5) * this.shake : 0;
        const shakeY = this.shake > 0 ? (Math.random() - 0.5) * this.shake : 0;
        return { 
            x: wx - this.x + this.viewWidth / 2 + shakeX, 
            y: wy - this.y + this.viewHeight / 2 + shakeY, 
            scale: 1 
        };

    }

    

    isVisible(wx, wy, radius = 50) {

        if (this.showFullRoom) {

            return wx >= -radius && wx <= SURVIVOR_CONFIG.ROOM_WIDTH + radius 

                && wy >= -radius && wy <= SURVIVOR_CONFIG.ROOM_HEIGHT + radius;

        }

        return Math.abs(wx - this.x) < this.viewWidth / 2 + radius && Math.abs(wy - this.y) < this.viewHeight / 2 + radius;

    }

}



class SpatialGrid {

    constructor() {

        this.cellSize = SURVIVOR_CONFIG.GRID_CELL_SIZE;

        this.cells = new Map();

    }

    getKey(cx, cy) { return `${cx},${cy}`; }

    getCellByPos(x, y) {

        return { cx: Math.floor(x / this.cellSize), cy: Math.floor(y / this.cellSize) };

    }

    clear() { this.cells.clear(); }

    insert(entity) {

        const { cx, cy } = this.getCellByPos(entity.x, entity.y);

        const key = this.getKey(cx, cy);

        if (!this.cells.has(key)) this.cells.set(key, []);

        this.cells.get(key).push(entity);

        entity._gridCell = { cx, cy };

    }

    getNearby(x, y) {

        const { cx, cy } = this.getCellByPos(x, y);

        const result = [];

        for (let dx = -1; dx <= 1; dx++) {

            for (let dy = -1; dy <= 1; dy++) {

                const cell = this.cells.get(this.getKey(cx + dx, cy + dy));

                if (cell) result.push(...cell);

            }

        }

        return result;

    }

}



