            ctx.fillRect(cw / 2 - 120, btn.y - 20, 240, 45);

            

            // ��ť�߿�

            ctx.strokeStyle = isHovered ? '#48f' : '#666';

            ctx.lineWidth = isHovered ? 2 : 1;

            ctx.strokeRect(cw / 2 - 120, btn.y - 20, 240, 45);

            

            // ��ť����

            ctx.fillStyle = isHovered ? '#fff' : '#ccc';

            ctx.font = isHovered ? 'bold 20px Arial' : '20px Arial';

            ctx.fillText(btn.text, cw / 2, btn.y + 8);

