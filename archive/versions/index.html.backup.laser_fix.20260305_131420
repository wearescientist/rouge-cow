    setupInput() {

        window.addEventListener('keydown', e => {

            this.keys[e.key] = true;

            

            // ���㻭�����

            if (this.showResultScreen) {

                if (e.key === ' ' || e.key === 'Enter' || e.key === 'Escape') {

                    this.returnToMainMenu();

                }

                return;

            }

            

            // v0.22: ͨ�ؾ��鰴���л�
            if (this.credits && this.credits.active) {
                if (e.key === ' ' || e.key === 'Enter') {
                    this.advanceCredits();
                }
                return;
            }

            

            // ESC��ͣ/�ָ���������Ϸ�У������̵�/�������棩

            if (e.key === 'Escape') {

                if (this.state === 'playing' && !this.shopOpen && !this.levelUpOpen) {

                    this.togglePause();

                }

                return;

            }

            

            // �����Ϸ��ͣ����������������

            if (this.paused) return;

            

            // ����ѡ����������4ѡ1��

            if (this.levelUpOpen) {

                if (e.key >= '1' && e.key <= '4') {

                    this.selectLevelUpOption(parseInt(e.key, 10) - 1);

                }

                return;

            }

            

            // ���佻��
            if (e.key === 'e' || e.key === 'E') {
                // �ر��Ѵ򿪵Ľ���
                if (this.chestOpen) {
                    this.closeChestSelect();
                    return;
                }
                
                // ���佻��
                if (this.curRoom.type === 'treasure' && this.curRoom.chest && !this.curRoom.chest.opened) {
                    const dx = this.player.x - this.curRoom.chest.x;
                    const dy = this.player.y - this.curRoom.chest.y;
                    const d = Math.sqrt(dx*dx + dy*dy);
                    if (d < 80) {
                        this.openChestSelect();
                    }
                    return;
                }
            }
            
            // �̵�NPC���� - F��̸��E�̵�
            if (this.curRoom.type === 'shop' && this.curRoom.npc) {
