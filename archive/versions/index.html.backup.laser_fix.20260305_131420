        ctx.fillStyle = 'rgba(10, 10, 20, 0.98)';

        ctx.fillRect(boxX, boxY, boxWidth, boxHeight);

        // ��ɫ�߿�

        ctx.strokeStyle = '#fa0';

        ctx.lineWidth = 4;

        ctx.strokeRect(boxX, boxY, boxWidth, boxHeight);

        // �ڱ߿�

        ctx.strokeStyle = '#840';

        ctx.lineWidth = 2;

