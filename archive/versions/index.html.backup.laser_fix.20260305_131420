    // ���½�ս�ӵ�
    updateMeleeBullet(b, enemies, stats, idx) {
        // v0.18.0 fix: ʹ���ӵ�λ��(b.x, b.y)�������λ��
        const attackX = b.x;
        const attackY = b.y;
        
        // v0.16.1 fix: ȷ�� hits ����
        if (!b.hits) b.hits = new Set();
        
        if (b.subtype === 'arc') {
            // v0.18.0 fix: ���λӻ� - ��ǿ���μ��
            const arcAngleRad = (b.arcAngle || 90) * Math.PI / 180;
            for (const e of enemies) {
                if (e.hp <= 0 || !b.hits || b.hits.has(e)) continue;
                
                // v0.18.0: ʹ�õ�����ͼ���ĵ�
                const ex = e.x;
                const ey = e.y - (e.size || 24) * 0.5; // ��ͼ����
                const dx = ex - attackX;
                const dy = ey - attackY;
                const enemyDist = Math.sqrt(dx*dx + dy*dy);
                
                // v0.18.0: ����Χȷ������������ͼ
                const effectiveRange = b.range + (e.size || 24) * 0.8;
                if (enemyDist > effectiveRange) continue;
                
                // v0.18.0: �򻯽Ƕȼ�⣬���������
                const angleToEnemy = Math.atan2(dy, dx);
                let angleDiff = angleToEnemy - b.angle;
                while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                
                // v0.18.0: ����Ƕ��ݲ��� + 15�ȣ�
                const halfArc = arcAngleRad / 2 + 0.26; // +15��
                if (Math.abs(angleDiff) <= halfArc) {
                    this.applyDamage(e, b.dmg, stats, b);
                    b.hits.add(e);
                }
            }
        } else if (b.subtype === 'circle') {
            // v0.18.0 fix: Բ�η�Χ - ����Χȷ��������ͼ
            for (const e of enemies) {
                if (e.hp <= 0 || !b.hits || b.hits.has(e)) continue;
                // v0.18.0: ʹ�ø���ļ��뾶
                const effectiveRange = b.range + (e.size || 24) * 0.5;
                if (e.intersectsCircle(attackX, attackY, effectiveRange)) {
                    this.applyDamage(e, b.dmg, stats, b);
                    b.hits.add(e);
                }
            }
        }
    }
    
    // ���¼�ʱ�ӵ������磩- v0.15.0�Ż��������ܵ���ʽ����
    updateInstantBullet(b, enemies, stats, idx) {
        if (b.subtype === 'chain') {
            // ��ʽ���磺������������ĵ��ˣ�Ȼ�����ε���
            const targets = [];
            let currentPos = { x: this.player.x, y: this.player.y };
            let usedTargets = new Set();
            
            for (let i = 0; i < b.chain; i++) {
                // Ѱ���������ЧĿ��
                let bestTarget = null;
                let bestScore = -1;
                
                for (const e of enemies) {
                    if (e.hp <= 0 || usedTargets.has(e)) continue;
                    // v0.17.1: ʹ�����ĵ�������
                    const d = dist(e.cx, e.cy, currentPos.x, currentPos.y);
                    if (d > b.chainRange) continue;
                    
                    // ���֣�����Խ��Խ�ã�Ѫ��Խ��Խ��
                    const score = (b.chainRange - d) + (100 - e.hp) * 0.5;
                    if (score > bestScore) {
                        bestScore = score;
                        bestTarget = e;
                    }
                }
                
                if (bestTarget) {
                    targets.push(bestTarget);
                    usedTargets.add(bestTarget);
                    this.applyDamage(bestTarget, b.dmg, stats, b);
                    currentPos = { x: bestTarget.x, y: bestTarget.y };
                } else {
                    break;
                }
            }
            
            // �����Ӿ�Ч��������ҵ���һ����Ȼ����ʽ - v0.16.3: ʹ�����ĵ�
            if (targets.length > 0) {
                let prevX = this.player.cx, prevY = this.player.cy;
                for (const target of targets) {
                    this.particles.lightning(prevX, prevY, target.cx, target.cy);
                    prevX = target.cx;
