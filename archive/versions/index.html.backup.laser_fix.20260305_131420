    // �ѷ��ʷ���=ʵ�ģ�δ���ʷ���=����

    updateMiniMap() {

        const canvas = document.getElementById('miniMapCanvas');

        if (!canvas) return;

        const ctx = canvas.getContext('2d');

        const size = 220;

        

        // ��ղ���䱳�������߿�

        ctx.fillStyle = '#1a1a2e';

        ctx.fillRect(0, 0, size, size);

        

        // ���Ʊ߿�

        ctx.strokeStyle = '#333';

        ctx.lineWidth = 2;

        ctx.strokeRect(0, 0, size, size);

        

        if (!this.allRooms || this.allRooms.size === 0) {

            console.warn('С��ͼ: allRoomsΪ��');

            return;

        }

        

        const rooms = Array.from(this.allRooms.values());

        

        // �����ͼ��Χ

        let minX = 0, maxX = 0, minY = 0, maxY = 0;

        for (const r of rooms) {

            minX = Math.min(minX, r.gx);

            maxX = Math.max(maxX, r.gx);

            minY = Math.min(minY, r.gy);

            maxY = Math.max(maxY, r.gy);

        }

        

        const width = maxX - minX + 1;

        const height = maxY - minY + 1;

        const padding = 20;

        const cellSize = Math.min((size - padding * 2) / width, (size - padding * 2) / height);

        const mapPixelW = width * cellSize;

        const mapPixelH = height * cellSize;

        const offsetX = (size - mapPixelW) / 2;

        const offsetY = (size - mapPixelH) / 2;

        

        // ���Ʒ���

        for (const r of rooms) {

            const rx = offsetX + (r.gx - minX) * cellSize + 2;

            const ry = offsetY + (r.gy - minY) * cellSize + 2;

            const rw = cellSize - 4;

            

            // δ���ʵķ���ֻ�����������������

            if (r.visited) {

                switch(r.type) {

                    case 'start': ctx.fillStyle = '#4f4'; break;

                    case 'boss': ctx.fillStyle = '#f44'; break;

                    case 'treasure': ctx.fillStyle = '#fa0'; break;

                    case 'shop': ctx.fillStyle = '#48f'; break;

                    case 'elite': ctx.fillStyle = '#a4f'; break; // ��Ӣ����ɫ

                    default: ctx.fillStyle = '#ccc';

                }

                ctx.fillRect(rx, ry, rw, rw);

            } else {

                ctx.strokeStyle = '#555';

                ctx.lineWidth = 1.5;

                ctx.strokeRect(rx, ry, rw, rw);

            }

            

            // ��ǰ���������������Ч����

            if (r === this.curRoom) {

                const pulse = 1 + Math.sin(Date.now() / 200) * 0.3;

                ctx.strokeStyle = '#ff0';

                ctx.lineWidth = 3;

                ctx.strokeRect(rx - 2, ry - 2, rw + 4, rw + 4);

                

                // ��Ȧ����

                ctx.strokeStyle = `rgba(255, 255, 0, ${0.5 * pulse})`;

                ctx.lineWidth = 2;

                ctx.strokeRect(rx - 5, ry - 5, rw + 10, rw + 10);

            }

        }

        

        // ����ͼ��

        ctx.font = '10px Arial';

        ctx.textAlign = 'left';

        ctx.fillStyle = '#4f4'; ctx.fillRect(5, size - 58, 8, 8);

        ctx.fillStyle = '#888'; ctx.fillText('���', 16, size - 51);

        ctx.fillStyle = '#f44'; ctx.fillRect(5, size - 45, 8, 8);

        ctx.fillStyle = '#888'; ctx.fillText('Boss', 16, size - 38);

        ctx.fillStyle = '#fa0'; ctx.fillRect(5, size - 32, 8, 8);

        ctx.fillStyle = '#888'; ctx.fillText('����', 16, size - 25);

        ctx.fillStyle = '#48f'; ctx.fillRect(5, size - 19, 8, 8);

        ctx.fillStyle = '#888'; ctx.fillText('�̵�', 16, size - 12);

        ctx.fillStyle = '#a4f'; ctx.fillRect(60, size - 58, 8, 8);

        ctx.fillStyle = '#888'; ctx.fillText('��Ӣ', 72, size - 51);

    }

    

