                ctx.shadowBlur = 10 * twinkle;
                ctx.shadowColor = 'rgba(255, 220, 100, 0.8)';
                ctx.fillStyle = `rgba(255, 240, 150, ${twinkle * 0.9})`;
                ctx.beginPath();
                ctx.arc(sx, sy, size, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
