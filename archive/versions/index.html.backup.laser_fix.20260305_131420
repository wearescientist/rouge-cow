    updateOrbitals(dt, enemies, stats) {
        if (!this.orbitals || !this.player) return;
        
        for (let i = this.orbitals.length - 1; i >= 0; i--) {
            const orb = this.orbitals[i];
            if (!orb) {
                this.orbitals.splice(i, 1);
                continue;
            }
            
            orb.angle += (orb.speed || 2) * dt;
            
            // v0.18.3: ���û����ﲻ��������
            if (!orb.permanent) {
                orb.life -= dt;
                if (orb.life <= 0) {
                    this.orbitals.splice(i, 1);
                    continue;
                }
            }
            
            // ����λ�� - v0.16.3: ʹ�����ĵ�
            const radius = orb.radius || 80;
            const ox = this.player.cx + Math.cos(orb.angle) * radius;
            const oy = this.player.cy + Math.sin(orb.angle) * radius;
            
            // v0.18.2 fix: �������˺���Χ���Ӿ�һ�� - ������ת·�������˺�
            if (enemies && Array.isArray(enemies)) {
                for (const e of enemies) {
