                        // v0.18.0: ʹ��getPierce()��ȡ������Ĵ�͸
                        life: 3, pierce: this.getPierce(), maxPierce: this.getPierce(),
                        hits: new Set(), delay: i * 0.03
                    });
                }
                break;
                
            case 'boomerang':
                for (let i = 0; i < count; i++) {
                    const angleOffset = count > 1 ? (i - (count - 1) / 2) * 0.3 : 0;
                    const angle = baseAngle + angleOffset;
                    bullets.push({
                        x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        life: 4, pierce: 99,
                        // v0.18.0: ʹ��getRange()��ȡ������ķ�Χ
                        range: this.getRange(),
                        originX: player.x, originY: player.y,
                        state: 'out', hits: new Set()
                    });
                }
                break;
                
            case 'bounce':
                for (let i = 0; i < count; i++) {
                    const angleOffset = count > 1 ? (i - (count - 1) / 2) * 0.2 : 0;
                    const angle = baseAngle + angleOffset;
                    bullets.push({
                        x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        life: 5, pierce: 99,
                        bounce: this.cfg.bounce || 3,
                        bouncesLeft: this.cfg.bounce || 3,
                        hits: new Set()
                    });
                }
                break;
                
            case 'explode':
                for (let i = 0; i < count; i++) {
                    const angleOffset = count > 1 ? (i - (count - 1) / 2) * 0.15 : 0;
                    const angle = baseAngle + angleOffset;
                    bullets.push({
                        x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        life: 3, pierce: 0,
                        explodeRadius: this.cfg.explodeRadius || 80,
                        hits: new Set()
                    });
                }
                break;
                
            case 'fan':
                // v0.18.0 fix: �Ż���������Ƕȼ��㣬ȷ������Ŀ��
                const spread = (this.cfg.spread || 25) * Math.PI / 180;
                for (let i = 0; i < count; i++) {
                    // ��count=1ʱ������ǰ����count>1ʱ���ȷֲ�
                    const angle = count === 1 ? baseAngle : baseAngle - spread / 2 + (spread / (count - 1)) * i;
                    bullets.push({
                        x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        // v0.18.0: ʹ��getPierce()��ȡ������Ĵ�͸
                        life: 2.5, pierce: this.getPierce(), maxPierce: this.getPierce(),
                        hits: new Set()
                    });
                }
                break;
                
            case 'penetrate':
                for (let i = 0; i < count; i++) {
                    const angle = baseAngle + (Math.random() - 0.5) * 0.1;
                    // v0.18.0: ʹ��getPierce()��ȡ������Ĵ�͸
                    const pierce = this.getPierce();
                    bullets.push({
                        x: player.cx, y: player.cy,
                        vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        life: 4, pierce: pierce || 99, maxPierce: pierce || 99,
                        slow: this.cfg.slow || 0,
                        hits: new Set()
                    });
                }
                break;
                
            case 'orbit_proj':
                // v0.18.3: ���价���������õģ�����Ҫ��������
                if (this.isSuper) return [];
                
                for (let i = 0; i < count; i++) {
                    const startAngle = (Math.PI * 2 / count) * i;
                    // v0.18.0: ʹ��getPierce()��ȡ������Ĵ�͸
                    const pierce = this.getPierce();
                    bullets.push({
                        x: player.cx, y: player.cy,
                        type: 'proj', subtype: subtype,
                        dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                        life: this.cfg.orbitDuration || 2,
                        orbitRadius: this.cfg.orbitRadius || 100,
                        orbitAngle: startAngle,
                        orbitSpeed: 3,
                        state: 'orbit',
                        target: target, speed: speed,
                        pierce: pierce, maxPierce: pierce,
                        hits: new Set()
                    });
                }
                break;
        }
        
        // v0.18.3: Ϊ����Ͷ�������ӱ��
        if (this.isSuper) {
            for (const b of bullets) b.isSuper = true;
        }
        
        // v0.18.4 fix: Ӧ�õ���Ч���������ӵ�
        for (const b of bullets) {
            // homingЧ�������ӵ�����׷������
            if (stats.homing && !b.homing) {
                b.homing = true;
                b.homingStrength = stats.homing;
                b.target = target;
                b.hits = b.hits || new Set();
            }
            // bounceЧ�������ӵ����ӵ�������
            if (stats.bounce && !b.bounce) {
                b.bounce = stats.bounce;
                b.bouncesLeft = stats.bounce;
            }
            // projSizeЧ�����ӵ���С
            if (stats.projSize) {
                b.scale = 1 + stats.projSize;
            }
        }
        
        return bullets;
    }
    
    // ���ƹ�����ʥ����
    fireOrbit(player, dmg, stats) {
        // v0.18.3: ���价���������õģ�����Ҫ��������
        if (this.isSuper) return [];
        
        // ���������ǣ�����Ϸѭ����������
        // v0.18.0 fix: ʹ��������ķ�Χ������
        return [{
            x: player.cx, y: player.cy,
            type: 'orbit_spawn',
            dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
            range: this.getRange() * (1 + (stats.range || 0)),
            count: this.getProjectileCount(),
            duration: (this.cfg.duration || 5) * (1 + (stats.duration || 0)),
            hits: new Set()
        }];
    }
    
    // ��ʱ���������磩
    // v0.18.0: ʹ��������ķ�Χ
    fireInstant(player, target, dmg, subtype, stats) {
        const range = this.getRange() * (1 + (stats.range || 0));
        
        if (subtype === 'chain') {
            // ����������Ч
            window.game.audioCtrl.play('lightning');
            return [{
                x: player.cx, y: player.cy,  // v0.16.3: ʹ�����ĵ�
                type: 'instant', subtype: subtype,
                dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                range: range, chain: this.cfg.chain || 3,
                chainRange: this.cfg.chainRange || 120,
                firstTarget: target,
                hits: new Set()
            }];
        }
        
        // v0.25: ������������
        if (subtype === 'laser_beam' || subtype === 'prism_beam') {
            // ���ż�����Ч
            window.game.audioCtrl.play('laser');
            
            const angle = target ? Math.atan2(target.cy - player.cy, target.cx - player.cx) : 
                         (player.facingRight ? 0 : Math.PI);
            
            return [{
                x: player.cx, y: player.cy,
                type: 'instant', subtype: subtype,
                dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                range: range, pierce: this.cfg.pierce || 99,
                beamWidth: this.cfg.beamWidth || 8,
                beamDuration: this.cfg.beamDuration || 0.3,
                angle: angle,
                prismSplit: this.cfg.prismSplit || false,
                forkCount: this.cfg.forkCount || 0,
                forkAngle: this.cfg.forkAngle || 30,
                hits: new Set()
            }];
        }
        
        return [];
    }
    
    // ���򹥻���ʥˮ��- v0.22: ��ƿ���䣬ȫ������
    fireArea(player, target, dmg, stats) {
        const range = this.getRange() * (1 + (stats.range || 0));
        const areaSize = this.cfg.areaSize || 1.0;
        // ��ȡ����������ʹ��cfg.count�������󣩣�����1ƿ
        const count = this.cfg.count || 1;
        const bullets = [];
        
        for (let i = 0; i < count; i++) {
            // ÿƿ��ͬ�Ƕȣ����ηֲ�
            let angle, distance;
            
            if (this.cfg.homing && target) {
                // ����׷�٣���׼���ˣ��������ƫ��
                const targetAngle = Math.atan2(target.cy - player.cy, target.cx - player.cx);
                angle = targetAngle + (Math.random() - 0.5) * 0.5; // ��0.25����ƫ��
                distance = Math.min(range * 1.5, Math.hypot(target.cx - player.cx, target.cy - player.cy));
            } else {
                // ��ͨģʽ������������Χ
                angle = Math.random() * Math.PI * 2;
                distance = range * (0.5 + Math.random() * 0.8); // 50%-130%��Χ
            }
            
            const tx = player.cx + Math.cos(angle) * distance;
            const ty = player.cy + Math.sin(angle) * distance;
            
            bullets.push({
                x: tx, y: ty,
                type: 'area', subtype: this.cfg.subtype || 'burn',
                dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
                range: range * areaSize, duration: (this.cfg.duration || 6) * (1 + (stats.duration || 0)),
                tickRate: this.cfg.tickRate || 0.3,
                slow: this.cfg.slow || 0,
                life: (this.cfg.duration || 6) * (1 + (stats.duration || 0)),
                hits: new Set(), lastTick: 0
            });
        }
        
        return bullets;
    }
    
    // �⻷����������/ħ�����ϣ�- v0.18.0: ʹ��������ķ�Χ
    fireAura(player, dmg, stats) {
        const range = this.getRange() * (1 + (stats.range || 0));
        
        return [{
            x: player.cx, y: player.cy,  // v0.17.2: ʹ�����ĵ���ǽŵ�
            type: 'aura', subtype: 'standard',
            dmg: dmg, color: this.cfg.color, icon: this.cfg.icon,
            range: range, tickRate: this.cfg.tickRate || 0.3,
            life: 0.5, hits: new Set(), lastTick: 0
        }];
    }

}



