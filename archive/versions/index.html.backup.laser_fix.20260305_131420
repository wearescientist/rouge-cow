class BloodStainSystem {
    constructor() {
        this.stainsByRoom = new Map(); // ������洢Ѫ��
    }
    
    // ��ȡ�����Ѫ������
    getRoomStains(room) {
        if (!room) return [];
        const key = room.id || 'default';
        if (!this.stainsByRoom.has(key)) {
            this.stainsByRoom.set(key, []);
        }
        return this.stainsByRoom.get(key);
    }
    
    // ����Ѫ�� - hitDir�ǻ��з�������罦��
    addStain(x, y, enemyColor, isBoss, room, hitDir = null, enemyType = 'normal') {
        const stains = this.getRoomStains(room);
        stains.push(new BloodStain(x, y, enemyColor, isBoss, hitDir, enemyType));
    }
    
    // ����Ѫ��
    draw(ctx, room, camera) {
        const stains = this.getRoomStains(room);
        for (const stain of stains) {
            stain.draw(ctx, camera);
        }
    }
    
    // ��������Ѫ�����л�¥��ʱ��
    clearRoom(room) {
        if (!room) return;
        const key = room.id || 'default';
        this.stainsByRoom.delete(key);
    }
}

class DamageNumberSystem {

    constructor(max = 100) {

        this.pool = Array(max).fill(null).map(() => ({

            x: 0, y: 0, value: 0, life: 0, maxLife: 1,

            color: '#ffffff', size: 14, active: false,

            vx: 0, vy: 0, critical: false

        }));

        this.active = [];

    }

    

    spawn(x, y, value, opts = {}) {

        const dn = this.pool.find(d => !d.active) || this.pool[0];

        dn.x = x; dn.y = y; dn.value = value; dn.active = true;

        dn.life = opts.life || 0.8; dn.maxLife = dn.life;

        dn.size = opts.size || (opts.critical ? 22 : 14);

        dn.color = opts.color || (opts.critical ? '#ff0' : '#fff');

        dn.critical = opts.critical || false;

        dn.vx = rand(-30, 30);

        dn.vy = opts.critical ? -120 : -80;

        if (!this.active.includes(dn)) this.active.push(dn);

    }

    

    spawnHeal(x, y, value) {

        this.spawn(x, y, '+' + value, { color: '#44ff44', life: 1.0, size: 16 });

    }

    

    update(dt) {

        for (let i = this.active.length - 1; i >= 0; i--) {

            const dn = this.active[i];

            dn.x += dn.vx * dt;

            dn.y += dn.vy * dt;

            dn.vy += 200 * dt; // ����

            dn.life -= dt;

            if (dn.life <= 0) {

                dn.active = false;

                this.active.splice(i, 1);

            }

        }

    }

    

    draw(ctx, camera) {

        ctx.textAlign = 'center';

        ctx.textBaseline = 'middle';

        
        // ʹ�� EffectSpriteData ��Ⱦ�˺�����
        const useEffectData = window.effectSpriteData && this.active.some(dn => dn.active);
        
        if (useEffectData) {
            // �����ͷ���
            const normalNums = [];
            const critNums = [];
            const healNums = [];
            
            for (const dn of this.active) {
                const progress = 1 - (dn.life / dn.maxLife);
                let type = 'normal';
                if (dn.type === 'heal' || (typeof dn.value === 'string' && dn.value.startsWith('+'))) type = 'heal';
                else if (dn.critical) type = 'crit';
                
                const config = window.effectSpriteData.getDamageNumberConfig(type);
                const anim = window.effectSpriteData.calculateDamageAnimation(config, dn.life / dn.maxLife);
                
                const screenPos = camera ? camera.worldToScreen(dn.x, dn.y) : { x: dn.x, y: dn.y };
                
                (type === 'crit' ? critNums : type === 'heal' ? healNums : normalNums).push({
                    value: dn.value,
                    x: screenPos.x + anim.x,
                    y: screenPos.y + anim.y,
                    alpha: anim.alpha * Math.min(1, dn.life / dn.maxLife * 2),
                    scale: anim.scale,
                    config: config
                });
            }
            
            // ������Ⱦ
            for (const group of [normalNums, healNums, critNums]) {
                if (group.length === 0) continue;
                const first = group[0];
                ctx.font = first.config.font;
                ctx.save();
                
                for (const num of group) {
                    ctx.globalAlpha = num.alpha;
                    ctx.setTransform(num.scale, 0, 0, num.scale, num.x, num.y);
                    
                    if (first.config.strokeWidth > 0) {
                        ctx.strokeStyle = first.config.strokeColor;
                        ctx.lineWidth = first.config.strokeWidth;
                        ctx.strokeText(num.value, 0, 0);
                    }
                    
                    ctx.fillStyle = first.config.color;
                    ctx.fillText(num.value, 0, 0);
                }
                
                ctx.restore();
            }
        } else {
            // ���˵�ԭʼ��Ⱦ
            for (const dn of this.active) {

                const alpha = Math.min(1, dn.life / dn.maxLife * 2);

                ctx.globalAlpha = alpha;

                ctx.font = `bold ${dn.size}px Arial`;

                

                // ʹ�����ת���������굽��Ļ����

                const screenPos = camera ? camera.worldToScreen(dn.x, dn.y) : { x: dn.x, y: dn.y };

                

                // ����Ч�� - �������

                if (dn.critical) {

                    ctx.shadowBlur = 10;

                    ctx.shadowColor = '#f80';

                    ctx.strokeStyle = '#800';

                    ctx.lineWidth = 2;

                    ctx.strokeText(dn.value, screenPos.x, screenPos.y);

                }

                

                ctx.fillStyle = dn.color;

                ctx.fillText(dn.value, screenPos.x, screenPos.y);

                ctx.shadowBlur = 0;

            }
        }

        ctx.globalAlpha = 1;

    }

}



