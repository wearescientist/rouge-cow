        });
        // ��������
        this.sparkle(x, y, '#fff', 8);
    }



    update(dt) {

        for (let i = this.active.length - 1; i >= 0; i--) {

            const p = this.active[i];

            p.x += p.vx * dt;

            p.y += p.vy * dt;

            p.vy += p.gravity * dt * 60;

            p.rotation += p.rotSpeed * dt;

            p.life -= dt;

            if (p.life <= 0) {

                p.active = false;

                this.active.splice(i, 1);

            }

        }

    }



    draw(ctx, camera) {

        for (const p of this.active) {

            const alpha = p.life / p.maxLife;

            ctx.globalAlpha = alpha;

            ctx.fillStyle = p.color;

            

            // ����Ч��

            if (p.glow > 0) {

                ctx.shadowBlur = p.glow;

                ctx.shadowColor = p.color;

            }

            

            ctx.save();

            // ����� camera��ת���������굽��Ļ����
            let screenX = p.x, screenY = p.y;
            if (camera && camera.worldToScreen) {
                const pos = camera.worldToScreen(p.x, p.y);
                screenX = pos.x;
                screenY = pos.y;
            }
            ctx.translate(screenX, screenY);

            ctx.rotate(p.rotation);

            

            if (p.type === 'sprite' && p.sprite) {
                // ʹ����ͼ��������
                const sprite = window.game && window.game.sprites ? window.game.sprites.get(p.sprite) : null;
                if (sprite) {
                    const s = p.size * 2;
                    ctx.drawImage(sprite, -s/2, -s/2, s, s);
                } else {
                    // ��ͼδ���أ����˵�Բ��
                    ctx.beginPath();
                    ctx.arc(0, 0, p.size/2, 0, Math.PI * 2);
                    ctx.fill();
                }
            } else if (p.type === 'rect') {

                ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);

            } else if (p.type === 'circle') {

                ctx.beginPath();

                ctx.arc(0, 0, p.size/2, 0, Math.PI * 2);

                ctx.fill();

            } else if (p.type === 'star') {

                this.drawStar(ctx, 0, 0, 5, p.size, p.size/2);

            }

            

            ctx.restore();

            ctx.shadowBlur = 0;

        }

        ctx.globalAlpha = 1;

    }

    

    drawStar(ctx, cx, cy, spikes, outerRadius, innerRadius) {

        let rot = Math.PI / 2 * 3;

        let x = cx;

        let y = cy;

        let step = Math.PI / spikes;

        ctx.beginPath();

        ctx.moveTo(cx, cy - outerRadius);

        for (let i = 0; i < spikes; i++) {

            x = cx + Math.cos(rot) * outerRadius;

            y = cy + Math.sin(rot) * outerRadius;

            ctx.lineTo(x, y);

            rot += step;

            x = cx + Math.cos(rot) * innerRadius;

            y = cy + Math.sin(rot) * innerRadius;

            ctx.lineTo(x, y);

            rot += step;

        }

        ctx.lineTo(cx, cy - outerRadius);

        ctx.closePath();

        ctx.fill();

    }

    

    // v0.15.0 - ����Ч�����򵥵��Ӿ����֣�
