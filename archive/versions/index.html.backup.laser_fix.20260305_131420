                    // ����������ʾ MAX
                    const isMaxLevel = option.level >= option.maxLevel;
                    const levelText = isMaxLevel ? 'MAX' : (option.isNew ? 'Lv.1/8' : `Lv.${option.level}/${option.maxLevel}`);
                    ctx.fillText(levelText, centerX, infoY);

                }

                // ��������

