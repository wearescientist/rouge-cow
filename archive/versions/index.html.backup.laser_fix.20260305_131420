                    offsetY = Math.sin(this.x * 0.1 + this.animTimer * 5) * 2;
                    break;

                case 'heavy':
                    offsetY = Math.abs(walkPhase) * -4;
                    break;

                case 'sidle':
                    offsetY = 0;
                    break;

                case 'crawl':
                    offsetY = 4;
                    scaleY = 0.7;
                    break;

                case 'charge':
                    offsetY = Math.abs(walkPhase) * -2;
                    break;

                case 'dive':
                    offsetY = Math.sin(this.animTimer * 8) * 6;

                    break;

                default:
                    offsetY = walkPhase * 1.5;

            }

            

            // Ӧ�ñ任 - ֻ�������ƶ���ˮƽ��ת��û����ת
            ctx.translate(0, offsetY);
            ctx.scale(scaleX, scaleY);

            

            // v2.5: ʹ�� SpriteData ��ȷ����
            let spriteDrawX = -drawWidth;
            let spriteDrawY = -drawHeight * 2;
            let spriteDrawW = drawWidth * 2;
            let spriteDrawH = drawHeight * 2;
            
            if (window.spriteDataRegistry) {
                let spriteData = this._spriteData;
                if (!spriteData) {
                    spriteData = window.spriteDataRegistry.getFromImage(sprite);
                    if (spriteData) {
                        this._spriteData = spriteData;
                        // ������Ⱦ���ţ�Ŀ����ʾ�߶� / ԭʼ�����߶�
                        this._renderScale = (drawHeight * 2) / spriteData.canvasHeight;
                    }
                }
                
                if (spriteData) {
                    const scale = this._renderScale || (this.isBoss ? 1.5 : 0.67);
                    const renderSize = spriteData.getDrawSize(scale);
                    const renderPos = spriteData.worldToRender(0, 0, scale, 'feet');
                    spriteDrawX = renderPos.x;
                    spriteDrawY = renderPos.y;
                    spriteDrawW = renderSize.width;
                    spriteDrawH = renderSize.height;
                }
            }
            
            ctx.drawImage(sprite, spriteDrawX, spriteDrawY, spriteDrawW, spriteDrawH);

            

            ctx.restore();

        } else {

            // ʹ��emoji��Ϊ��

            const emojiMap = {

                chick: '??', pig: '??', sheep: '??', dog: '??', cat: '??',

                bear: '??', rabbit: '??', bird: '??', turtle: '??', dog2: '??',

                mouse: '??', snail: '??', squirrel: '???', goose: '??',

                duck: '??', duck2: '??', duck3: '??', snake: '??',

                crab: '??', pigeon: '???', pig2: '??', rabbit2: '??'

            };

            ctx.fillStyle = '#fff';  // ����Ϊ��ɫ������̳к�ɫ����

            ctx.font = this.isBoss ? '48px Arial' : '24px Arial';

            ctx.textAlign = 'center';

            ctx.fillText(emojiMap[this.sprite] || '??', 0, 8);

        }

        

        ctx.globalAlpha = 1;

        

        // Ѫ�� - ʼ����ʾ���Ż��Ӿ�Ч��
        const barWidth = this.isBoss ? 100 : 32;
        const barHeight = this.isBoss ? 8 : 5;
        // Ѫ���ھ��鶥��֮�ϣ�����߶��� drawHeight*2��������ƫ��
        const barY = -drawHeight * 2 - (this.isBoss ? 12 : 8);
        const hpPercent = Math.max(0, this.hp / this.maxHp);
        
        // Ѫ�����������߿�
        ctx.fillStyle = '#000';
        ctx.fillRect(-barWidth/2 - 1, barY - 1, barWidth + 2, barHeight + 2);
        
        // v0.9.5 - Ѫ����ɫʹ�����õ�color
        ctx.fillStyle = this.color || '#f44';
        ctx.fillRect(-barWidth/2, barY, barWidth * hpPercent, barHeight);
        
        // Ѫ���ղ�
        ctx.fillStyle = '#222';
        ctx.fillRect(-barWidth/2 + barWidth * hpPercent, barY, barWidth * (1 - hpPercent), barHeight);
        
        // v0.9.5 - T3/T4��ʾѪ������
        if (this.tier >= 3) {
            ctx.fillStyle = '#fff';
            ctx.font = 'bold 11px Arial';
            ctx.textAlign = 'center';
            const hpText = `${Math.floor(this.hp)}/${this.maxHp}`;
            ctx.fillText(hpText, 0, barY - 5);
        }

        

        if (this.isBoss) {

            ctx.fillStyle = '#f0f';

            ctx.font = 'bold 16px Arial';

            ctx.textAlign = 'center';

            ctx.fillText(this.name, 0, -size - 35);

        }

    }

}



