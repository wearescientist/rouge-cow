    // ���±���齱����
    updateBossChestLottery(dt) {
        const lottery = this.bossChestLottery;
        if (!lottery || !lottery.active) return;
        
        // ��������
        lottery.particles = lottery.particles.filter(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.life -= dt;
            p.vy += 0.3;
            return p.life > 0;
        });
        
        // ���ɱ�������
        if (Math.random() < 0.3) {
            const colors = ['#ffd700', '#ffaa00', '#ff6600', '#ff0066', '#ff00ff'];
            const color = colors[Math.floor(Math.random() * colors.length)];
            lottery.particles.push({
                x: 600 + (Math.random() - 0.5) * 400,
                y: 400 + (Math.random() - 0.5) * 300,
                vx: (Math.random() - 0.5) * 10,
                vy: (Math.random() - 0.5) * 10 - 5,
                life: 1 + Math.random(),
                color: color,
                size: 3 + Math.random() * 5
            });
        }
        
        // ��˸Ч��ǿ��
        lottery.glowIntensity += dt * 3;
        
        // �����׶�
        if (lottery.phase === 'rolling') {
            lottery.rollProgress += dt * lottery.rollSpeed;
            lottery.rollSpeed += dt * 0.5; // ����
            
            // ���ݽ���ȼ��ı䱳����˸�ٶ�
            const targetProgress = lottery.resultTier === 5 ? 4 : (lottery.resultTier === 3 ? 3 : 2.5);
            
            if (lottery.rollProgress >= targetProgress) {
                lottery.phase = 'revealing';
                lottery.currentReveal = 0;
                lottery.revealTimer = 0;
                // ���Ž�ʾ��Ч
                this.audioCtrl.play('levelup');
            }
        }
        // ��ʾ�׶�
        else if (lottery.phase === 'revealing') {
            lottery.revealTimer += dt;
            
            // �����ʾ����
            const revealInterval = lottery.resultTier === 5 ? 0.4 : (lottery.resultTier === 3 ? 0.6 : 0.8);
            
            if (lottery.currentReveal < lottery.revealedWeapons.length && lottery.revealTimer >= revealInterval) {
                const weapon = lottery.revealedWeapons[lottery.currentReveal];
                weapon.revealed = true;
                
                // ��ʾ��Ч
                for (let i = 0; i < 20; i++) {
                    lottery.particles.push({
                        x: 600,
                        y: weapon.targetY,
                        vx: (Math.random() - 0.5) * 15,
                        vy: (Math.random() - 0.5) * 15,
                        life: 1.5,
                        color: '#ffd700',
                        size: 4 + Math.random() * 4
                    });
                }
                
                lottery.currentReveal++;
                lottery.revealTimer = 0;
                this.audioCtrl.play('chest');
            }
            
            // �����ѽ�ʾ�����Ķ���
            lottery.revealedWeapons.forEach((w, i) => {
                if (w.revealed) {
                    w.scale = Math.min(1, w.scale + dt * 3);
                    w.y += (w.targetY - w.y) * dt * 5;
                    w.rotation *= 0.9;
                }
            });
            
            // ȫ����ʾ���
            if (lottery.currentReveal >= lottery.revealedWeapons.length && lottery.revealTimer > 2) {
                lottery.phase = 'done';
            }
        }
    }
    
