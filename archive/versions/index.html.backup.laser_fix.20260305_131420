        // ��������
        const bgGradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, Math.max(w, h));
        bgGradient.addColorStop(0, 'rgba(0, 0, 0, 0.95)');
        bgGradient.addColorStop(0.5, `rgba(20, 10, 0, 0.9)`);
        bgGradient.addColorStop(1, 'rgba(0, 0, 0, 0.98)');
        ctx.fillStyle = bgGradient;
        ctx.fillRect(0, 0, w, h);
        
        // ��˸�߿�
        const glowAlpha = 0.5 + Math.sin(lottery.glowIntensity) * 0.3;
        const borderGradient = ctx.createLinearGradient(0, 0, w, h);
        borderGradient.addColorStop(0, `rgba(255, 215, 0, ${glowAlpha})`);
        borderGradient.addColorStop(0.5, `rgba(255, 170, 0, ${glowAlpha * 0.5})`);
        borderGradient.addColorStop(1, `rgba(255, 215, 0, ${glowAlpha})`);
        ctx.strokeStyle = borderGradient;
        ctx.lineWidth = 4;
        ctx.strokeRect(10, 10, w - 20, h - 20);
        
        // ����
        ctx.font = 'bold 48px Arial';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#ffd700';
        ctx.shadowColor = '#ffaa00';
        ctx.shadowBlur = 20;
        ctx.fillText('?? ��ɫBoss���� ??', centerX, 80);
        ctx.shadowBlur = 0;
        
        // ״̬����
        ctx.font = '24px Arial';
        if (lottery.phase === 'rolling') {
            const dots = '.'.repeat(Math.floor(lottery.glowIntensity * 2) % 4);
            ctx.fillStyle = `rgba(255, 215, 0, ${0.5 + Math.sin(lottery.glowIntensity * 2) * 0.5})`;
            ctx.fillText(`?? �齱��${dots}`, centerX, 130);
            
            // �����еı���ͼ��
