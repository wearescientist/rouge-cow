    drawLevelUpUI() {

        const ctx = this.ctx;

        const boxWidth = 640;

        const boxHeight = 460;

        const boxX = (ctx.canvas.width || 900) / 2 - boxWidth / 2;

        const boxY = (ctx.canvas.height || 600) / 2 - boxHeight / 2;

