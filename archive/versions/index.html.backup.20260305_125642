    // 光环效果 - v0.18.3: 重新设计，填充范围+随机闪光
    drawAuraEffect(b, pos, time, zoom = 1) {
        const ctx = this.ctx;
        ctx.save();
        ctx.translate(pos.x, pos.y);
        
        const worldRange = b.range || 150;
        const screenRadius = worldRange * zoom;
        const isSolar = b.color === '#ffaa00' || b.color === '#ff6600'; // 日天辉耀/辉耀
        
        // v0.18.3: 辉耀特效 - 金色填充范围
        if (isSolar) {
            // ===== 日天辉耀特效 =====
            // 1. 深色底层填充
            const baseGradient = ctx.createRadialGradient(0, 0, 0, 0, 0, screenRadius);
            baseGradient.addColorStop(0, 'rgba(255, 200, 50, 0.15)');
            baseGradient.addColorStop(0.5, 'rgba(255, 150, 30, 0.10)');
            baseGradient.addColorStop(0.9, 'rgba(255, 100, 20, 0.05)');
            baseGradient.addColorStop(1, 'rgba(255, 80, 0, 0)');
            ctx.fillStyle = baseGradient;
            ctx.fillRect(-screenRadius, -screenRadius, screenRadius * 2, screenRadius * 2);
            
            // 2. 随机金色闪光（星星点缀）- v0.18.3: 更多星星，更强发光
            const seed = Math.floor(time * 10);
            const sparkleCount = worldRange >= 300 ? 15 : 10; // 超武更多星星
            for (let i = 0; i < sparkleCount; i++) {
                const angle = ((seed * 137.5 + i * 45) % 360) * Math.PI / 180;
                const dist = ((seed * 0.3 + i * 0.1) % 0.9 + 0.1) * screenRadius;
                const sx = Math.cos(angle) * dist;
                const sy = Math.sin(angle) * dist;
                const twinkle = Math.sin(time * 10 + i * 0.7) * 0.5 + 0.5;
                const size = (2 + Math.sin(time * 5 + i)) * (worldRange >= 300 ? 1.5 : 1) * zoom;
                
                // 发光效果
                ctx.shadowBlur = 10 * twinkle;
                ctx.shadowColor = 'rgba(255, 220, 100, 0.8)';
                ctx.fillStyle = `rgba(255, 240, 150, ${twinkle * 0.9})`;
                ctx.beginPath();
                ctx.arc(sx, sy, size, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }
            
            // 3. 脉冲波纹 - v0.18.3: 更多波纹，超武更强
            const waveCount = worldRange >= 300 ? 3 : 2;
            for (let i = 0; i < waveCount; i++) {
                const offset = (time * 0.8 + i * 0.33) % 1;
                const alpha = worldRange >= 300 ? (1 - offset) * 0.5 : (1 - offset) * 0.4;
                ctx.strokeStyle = `rgba(255, 220, 120, ${alpha})`;
                ctx.lineWidth = (worldRange >= 300 ? 4 : 3) * zoom;
                ctx.beginPath();
                ctx.arc(0, 0, screenRadius * (0.2 + offset * 0.8), 0, Math.PI * 2);
                ctx.stroke();
            }
            
            // 4. 超武额外效果：中心太阳核心
            if (worldRange >= 300) {
                const corePulse = Math.sin(time * 4) * 0.3 + 0.7;
                ctx.fillStyle = `rgba(255, 255, 200, ${0.3 * corePulse})`;
                ctx.beginPath();
                ctx.arc(0, 0, screenRadius * 0.15 * corePulse, 0, Math.PI * 2);
                ctx.fill();
            }
        } else {
            // ===== 普通光环特效 =====
            const hexToRgba = (hex, alpha) => {
                const r = parseInt(hex.slice(1, 3), 16);
                const g = parseInt(hex.slice(3, 5), 16);
                const b = parseInt(hex.slice(5, 7), 16);
                return `rgba(${r}, ${g}, ${b}, ${alpha})`;
            };
            const fillGradient = ctx.createRadialGradient(0, 0, 0, 0, 0, screenRadius);
            fillGradient.addColorStop(0, hexToRgba(b.color, 0.12));
            fillGradient.addColorStop(0.5, hexToRgba(b.color, 0.06));
            fillGradient.addColorStop(0.9, hexToRgba(b.color, 0.10));
            fillGradient.addColorStop(1, hexToRgba(b.color, 0));
            
            ctx.fillStyle = fillGradient;
            ctx.fillRect(-screenRadius, -screenRadius, screenRadius * 2, screenRadius * 2);
            
            // 随机闪光点
            for (let i = 0; i < 5; i++) {
                const angle = ((time * 50 + i * 72) % 360) * Math.PI / 180;
                const dist = ((Math.sin(time * 0.5 + i) + 1) * 0.4 + 0.1) * screenRadius;
                const sx = Math.cos(angle) * dist;
                const sy = Math.sin(angle) * dist;
                const twinkle = Math.sin(time * 6 + i) * 0.5 + 0.5;
                
                ctx.fillStyle = hexToRgba(b.color, twinkle * 0.6);
                ctx.beginPath();
                ctx.arc(sx, sy, 2 * zoom, 0, Math.PI * 2);
                ctx.fill();
            }
        }
        
        ctx.restore();
    }
    
    // 默认投射物 - 简洁光点 - v0.17.1: 添加zoom支持
    // v0.18.0: 计算颜色的反色用于描边
    getContrastingColor(hex) {
        // 移除# 并解析RGB
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        // 使用YIQ方法判断亮度
        const yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
        return yiq >= 128 ? '#000000' : '#ffffff';
    }
    
