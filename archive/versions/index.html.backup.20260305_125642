        this.shopRefreshCount = 0;
        this.shopItems = []; // v0.9.5 - 每层商店自动刷新

        

        // 重新生成地图

        const gen = new MapGenerator();

        const map = gen.generate(this.currentFloor);

        this.curRoom = map.start;

        this.allRooms = map.rooms;

        this.curRoom.visited = true;

        this.allFloors.set(this.currentFloor, { start: map.start, rooms: map.rooms });

        

        // 确保新房间的 items 数组有效

        if (!this.curRoom.items) {

            this.curRoom.items = [];

        }

        

        // 传送玩家到新地图起点

        this.player.x = this.curRoom.centerX;

        this.player.y = this.curRoom.centerY;

        

        // 恢复一些生命值（每层恢复1点）

        this.player.hp = Math.min(this.player.maxHp, this.player.hp + 1);

        

        // 分数：进入新层

        this.scoreManager.onEnterFloor(this.currentFloor);

        

        // 更新UI

        this.updateScoreDisplay();

        

        // 特效

        this.particles.burst(this.player.cx, this.player.cy, '#4f4', 30);  // v0.16.3: 使用中心点

    }



    // 存档系统（第5次迭代）

    saveGame() {

        try {

            const saveData = {

                player: {

                    hp: this.player.hp,

                    maxHp: this.player.maxHp,

                    exp: this.player.exp,

                    lv: this.player.lv,

                    gold: this.player.gold

                },

                items: this.items.owned,

                weapons: this.weapons.map(w => ({ key: w.baseKey, level: w.level, evolution: w.evolution })),

                currentFloor: this.currentFloor,

                timestamp: Date.now()

            };

            localStorage.setItem('rougecow_save', JSON.stringify(saveData));

            // v0.17.2: 移除调试日志
            // console.log('💾 游戏已存档');

            return true;

        } catch (e) {

            console.error('存档失败:', e);

            return false;

        }

    }

    

    loadGame() {

        try {

            const saveData = localStorage.getItem('rougecow_save');

            if (!saveData) return false;

            

            const data = JSON.parse(saveData);

            

            // 恢复玩家数据

            Object.assign(this.player, data.player);

            

            // 恢复道具

            this.items.owned = data.items || {};

            this.items.dirty = true;

            

            // 恢复武器

            if (data.weapons && data.weapons.length > 0) {

                this.weapons = data.weapons.map(w => new Weapon(w.key, w.level, w.evolution));

            }

            

            // 恢复层数

            this.currentFloor = data.currentFloor || 1;

            

            // v0.17.2: 移除调试日志
            // console.log('📂 游戏已加载');

            return true;

        } catch (e) {

            console.error('读档失败:', e);

            return false;

        }

    }

    

    hasSave() {

        return !!localStorage.getItem('rougecow_save');

    }

    

    deleteSave() {
        localStorage.removeItem('rougecow_save');
        // v0.17.2: 移除调试日志
        // console.log('🗑️ 存档已删除');
    }
    
    // Boss奖励视觉反馈
    showBossRewardFeedback(upgradedItems) {
        // 在玩家头顶显示升级信息
        const itemNames = upgradedItems.map(id => ITEMS[id]?.name || '?').join(', ');
        
        // 生成金色粒子爆发效果
        this.particles.burst(this.player.cx, this.player.cy - 30, '#fa0', 20);  // v0.16.3: 使用中心点
        
        // 显示浮动文字
        this.damageNumbers.spawn(
            this.player.x, 
            this.player.y - 50, 
            `+${upgradedItems.length} 升级!`, 
            { color: '#ffaa00', size: 20, life: 1.5 }
        );
        
        // 屏幕震动效果
        this.camera.shake = 0.3;
        
        // v0.17.2: 移除调试日志
        // console.log(`🎁 Boss战利品: ${itemNames}`);
    }

    loop(t) {

        let dt = Math.min((t - (this.lastT || t)) / 1000, 0.1) * this.timeScale;

        if (dt < 0) {

            console.warn(`[Game] dt为负数: ${dt}, 重置为0`);

            dt = 0;

        }

        this.lastT = t;

        

        // 更新性能监控

        this.perfMonitor.update();

        

        if (this.state === 'playing' || this.transition.active) {

            this.update(dt);

        }

        

        // 检测原地停留（防挂机）

        if (this.state === 'playing' && this.player && this.scoreManager.isPlaying) {

            this.scoreManager.checkStallPosition(this.player.x, this.player.y);

        }

        

        this.draw();

        

        // 绘制性能监控

        this.perfMonitor.draw(this.ctx, 10, 10);

        

        // 更新分数显示

        if (this.state === 'playing' && this.scoreManager.isPlaying) {

            this.updateScoreDisplay();

        }

        

        this.rafId = requestAnimationFrame(t => this.loop(t));

    }

    

    // 清理游戏资源 - 防止内存泄漏
    destroy() {
        // 取消动画帧
        if (this.rafId) {
            cancelAnimationFrame(this.rafId);
            this.rafId = null;
        }
        
        // 清理剧情系统
        if (window.prologueController) {
            window.prologueController.destroy();
        }
        if (window.storyEventSystem) {
            window.storyEventSystem.destroy();
        }
        if (window.trueEndingSystem) {
            window.trueEndingSystem.destroy();
        }
        if (window.shopNPCSystem) {
            window.shopNPCSystem.destroy();
        }
        
        // 清理DOM事件监听器
        window.removeEventListener('resize', this._boundResizeHandler);
        window.removeEventListener('keydown', this._boundKeyDownHandler);
        window.removeEventListener('keyup', this._boundKeyUpHandler);
        
            // v0.17.2: 移除调试日志
        // console.log('🧹 Game resources cleaned up');
    }

}



