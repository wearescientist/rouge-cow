            const hasHalf = this.player.hp % 2 === 1;

            let heartsStr = '';

            for (let i = 0; i < maxHearts; i++) {

                if (i < currentHearts) {

                    heartsStr += '❤️'; // 实心

                } else if (i === currentHearts && hasHalf) {

                    heartsStr += '💔'; // 半心（用破碎心代替）

