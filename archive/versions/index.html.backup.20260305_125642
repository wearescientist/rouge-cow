    // 绘制通关结局 - 纯黑背景白文字
    drawCredits(ctx) {
        if (!this.credits || !this.credits.active) return;
        
        const cw = this.canvas.width;
        const ch = this.canvas.height;
        const centerX = cw / 2;
        
        // 纯黑背景
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, cw, ch);
        
        if (this.credits.phase === 'ending') {
            const lines = this.credits.pages[this.credits.pageIndex];
            const elapsed = Date.now() - this.credits.startTime;
            
            // 文字样式：白色，居中，18px
            ctx.textAlign = 'center';
            ctx.fillStyle = '#ffffff';
            ctx.font = '18px Arial';
            
            const startY = ch * 0.25; // 从1/4处开始
            const lineHeight = 32;
            
            lines.forEach((line, i) => {
                // 逐行淡入效果
                const lineDelay = i * 400; // 每行延迟400ms
                const lineElapsed = elapsed - lineDelay;
                const alpha = Math.min(1, Math.max(0, lineElapsed / 600));
                
                if (alpha > 0 && line) {
                    ctx.save();
                    ctx.globalAlpha = alpha;
                    ctx.fillText(line, centerX, startY + i * lineHeight);
                    ctx.restore();
                }
            });
            
            // 绘制"点击继续"提示（所有文字显示后）
            const totalDelay = lines.length * 400 + 1000;
            if (elapsed > totalDelay) {
                const blink = Math.sin(Date.now() / 400) * 0.5 + 0.5;
                ctx.save();
                ctx.globalAlpha = blink * 0.6;
                ctx.font = '16px Arial';
                ctx.fillStyle = '#888888';
                ctx.fillText('点击或按空格键继续', centerX, ch - 60);
                ctx.restore();
            }
            
        } else if (this.credits.phase === 'thanks') {
            // 最终感谢页面
            const elapsed = Date.now() - this.credits.thanksStartTime;
            const progress = Math.min(1, elapsed / 1500);
            const alpha = Math.sin(progress * Math.PI / 2);
            
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.textAlign = 'center';
            
            // 感谢游玩大字
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 64px Arial';
            ctx.fillText('感谢游玩', centerX, ch / 2);
            
            ctx.restore();
            
            // 4秒后返回主菜单
            if (elapsed > 4000) {
                this.credits.active = false;
                this.returnToMainMenu();
            }
        }
    }
    
    // 点击切换到下一段
    advanceCredits() {
        if (!this.credits || !this.credits.active) return;
        
        if (this.credits.phase === 'ending') {
            this.credits.pageIndex++;
            this.credits.startTime = Date.now();
            
            // 三页结束后显示感谢
            if (this.credits.pageIndex >= this.credits.pages.length) {
                this.credits.phase = 'thanks';
                this.credits.thanksStartTime = Date.now();
            }
        }
    }

    

