    // 更新近战子弹
    updateMeleeBullet(b, enemies, stats, idx) {
        // v0.18.0 fix: 使用子弹位置(b.x, b.y)而非玩家位置
        const attackX = b.x;
        const attackY = b.y;
        
        // v0.16.1 fix: 确保 hits 存在
        if (!b.hits) b.hits = new Set();
        
        if (b.subtype === 'arc') {
            // v0.18.0 fix: 弧形挥击 - 增强扇形检测
            const arcAngleRad = (b.arcAngle || 90) * Math.PI / 180;
            for (const e of enemies) {
                if (e.hp <= 0 || !b.hits || b.hits.has(e)) continue;
                
                // v0.18.0: 使用敌人贴图中心点
                const ex = e.x;
                const ey = e.y - (e.size || 24) * 0.5; // 贴图中心
                const dx = ex - attackX;
                const dy = ey - attackY;
                const enemyDist = Math.sqrt(dx*dx + dy*dy);
                
                // v0.18.0: 扩大范围确保覆盖整个贴图
                const effectiveRange = b.range + (e.size || 24) * 0.8;
                if (enemyDist > effectiveRange) continue;
                
                // v0.18.0: 简化角度检测，提高命中率
                const angleToEnemy = Math.atan2(dy, dx);
                let angleDiff = angleToEnemy - b.angle;
                while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                
                // v0.18.0: 扩大角度容差（半角 + 15度）
                const halfArc = arcAngleRad / 2 + 0.26; // +15度
                if (Math.abs(angleDiff) <= halfArc) {
                    this.applyDamage(e, b.dmg, stats, b);
                    b.hits.add(e);
                }
            }
        } else if (b.subtype === 'circle') {
            // v0.18.0 fix: 圆形范围 - 扩大范围确保覆盖贴图
            for (const e of enemies) {
                if (e.hp <= 0 || !b.hits || b.hits.has(e)) continue;
                // v0.18.0: 使用更大的检测半径
                const effectiveRange = b.range + (e.size || 24) * 0.5;
                if (e.intersectsCircle(attackX, attackY, effectiveRange)) {
                    this.applyDamage(e, b.dmg, stats, b);
                    b.hits.add(e);
                }
            }
        }
    }
    
    // 更新即时子弹（闪电）- v0.15.0优化：更智能的链式闪电
    updateInstantBullet(b, enemies, stats, idx) {
        if (b.subtype === 'chain') {
            // 链式闪电：优先锁定最近的敌人，然后依次弹跳
            const targets = [];
            let currentPos = { x: this.player.x, y: this.player.y };
            let usedTargets = new Set();
            
            for (let i = 0; i < b.chain; i++) {
                // 寻找最近的有效目标
                let bestTarget = null;
                let bestScore = -1;
                
                for (const e of enemies) {
                    if (e.hp <= 0 || usedTargets.has(e)) continue;
                    // v0.17.1: 使用中心点计算距离
                    const d = dist(e.cx, e.cy, currentPos.x, currentPos.y);
                    if (d > b.chainRange) continue;
                    
                    // 评分：距离越近越好，血量越低越好
                    const score = (b.chainRange - d) + (100 - e.hp) * 0.5;
                    if (score > bestScore) {
                        bestScore = score;
                        bestTarget = e;
                    }
                }
                
                if (bestTarget) {
                    targets.push(bestTarget);
                    usedTargets.add(bestTarget);
                    this.applyDamage(bestTarget, b.dmg, stats, b);
                    currentPos = { x: bestTarget.x, y: bestTarget.y };
                } else {
                    break;
                }
            }
            
            // 闪电视觉效果：从玩家到第一个，然后链式 - v0.16.3: 使用中心点
            if (targets.length > 0) {
                let prevX = this.player.cx, prevY = this.player.cy;
                for (const target of targets) {
                    this.particles.lightning(prevX, prevY, target.cx, target.cy);
                    prevX = target.cx;
                    prevY = target.cy;
                }
            }
        }
    }
    
    // 更新区域子弹 - v0.15.0优化：更好的视觉效果和伤害逻辑
    updateAreaBullet(b, enemies, dt, idx) {
        b.life -= dt;
        b.lastTick = (b.lastTick || 0) + dt;
        
        // 持续伤害 - 每tick结算一次
        if (b.lastTick >= b.tickRate) {
            b.lastTick = 0;
            // 清除上次伤害记录，允许重复伤害
            b.hits = new Set();
            
            for (const e of enemies) {
                if (e.hp <= 0) continue;
                // v0.18.2: 检查敌人中心到区域中心的距离，考虑敌人半径
                const dx = e.cx - b.x;
                const dy = e.cy - b.y;
                const dist = Math.sqrt(dx*dx + dy*dy);
                if (dist <= b.range + (e.size || 24) * 0.5) {
                    this.applyDamage(e, b.dmg, {}, b);
                    if (b.slow) e.slowTimer = b.tickRate * 1.5;  // 持续减速
                }
            }
        }
        
        // 区域视觉效果：随时间变化的脉冲
        const pulse = Math.sin(Date.now() / 200) * 0.3 + 0.7;
        if (Math.random() < 0.4 * pulse) {
            this.particles.areaEffect(b.x, b.y, b.range * (0.8 + Math.random() * 0.4), b.color);
        }
    }
    
    // 更新光环子弹 - v0.18.2: 伤害范围与视觉一致
    updateAuraBullet(b, enemies, dt, idx) {
        b.life -= dt;
        b.lastTick = (b.lastTick || 0) + dt;
        
        if (b.lastTick >= b.tickRate) {
            b.lastTick = 0;
            for (const e of enemies) {
                if (e.hp <= 0) continue;
                // v0.18.2: 检查敌人中心到玩家中心的距离，考虑敌人半径
                const dx = e.cx - b.x;
                const dy = e.cy - b.y;
                const dist = Math.sqrt(dx*dx + dy*dy);
                // 如果敌人中心在范围内，或者敌人边缘接触范围
                if (dist <= b.range + (e.size || 24) * 0.5) {
                    this.applyDamage(e, b.dmg, {}, b);
                }
            }
        }
    }
    
    // 更新投射物子弹
    updateProjectileBullet(b, dt, enemies, stats) {
        const subtype = b.subtype || 'standard';
        
        // 处理延迟
        if (b.delay && b.delay > 0) {
            b.delay -= dt;
            return true;
        }
        
        // 拖尾效果
        if (Math.random() < 0.3) {
            this.particles.trail(b.x, b.y, b.color, 2);
        }
        
        // 根据子类型更新
        switch (subtype) {
            case 'homing':
            case 'poison_homing':
                // 追踪逻辑
                if (b.target && b.target.hp > 0) {
                    const dx = b.target.x - b.x;
                    const dy = b.target.y - b.y;
                    const d = Math.sqrt(dx*dx + dy*dy);
                    if (d > 0) {
                        const targetAngle = Math.atan2(dy, dx);
                        const currentAngle = Math.atan2(b.vy, b.vx);
                        let angleDiff = targetAngle - currentAngle;
                        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                        const turnRate = (b.homingStrength || 0.5) * 5 * dt;
                        const newAngle = currentAngle + Math.max(-turnRate, Math.min(turnRate, angleDiff));
                        const spd = Math.sqrt(b.vx*b.vx + b.vy*b.vy);
                        b.vx = Math.cos(newAngle) * spd;
                        b.vy = Math.sin(newAngle) * spd;
                    }
                }
                break;
                
            case 'boomerang':
                // 回旋镖状态机
                if (b.state === 'out') {
                    const dx = b.x - b.originX;
                    const dy = b.y - b.originY;
                    if (Math.sqrt(dx*dx + dy*dy) > b.range) {
                        b.state = 'back';
                    }
                } else if (b.state === 'back') {
                    // v0.16.3: 使用中心点
                    const dx = this.player.cx - b.x;
                    const dy = this.player.cy - b.y;
                    const d = Math.sqrt(dx*dx + dy*dy);
                    const angle = Math.atan2(dy, dx);
                    const spd = Math.sqrt(b.vx*b.vx + b.vy*b.vy);
                    b.vx = Math.cos(angle) * spd;
                    b.vy = Math.sin(angle) * spd;
                    if (d < 20) return false; // 回到玩家身边，消失
                }
                break;
                
            case 'orbit_proj':
                // 环绕投射物
                if (b.state === 'orbit') {
                    b.orbitAngle += b.orbitSpeed * dt;
                    // v0.16.3: 使用中心点
                    b.x = this.player.cx + Math.cos(b.orbitAngle) * b.orbitRadius;
                    b.y = this.player.cy + Math.sin(b.orbitAngle) * b.orbitRadius;
                    b.life -= dt;
                    
                    // v0.16.3 fix: 环绕状态下也要进行碰撞检测 - v0.17.1: 使用贴图范围检测
                    if (!b.hits) b.hits = new Set();
                    for (const e of enemies) {
                        if (e.hp <= 0 || b.hits.has(e)) continue;
                        if (e.containsPoint(b.x, b.y)) {  // v0.17.1: 贴图范围碰撞检测
                            b.hits.add(e);
                            this.applyDamage(e, b.dmg, stats, b);
                            // 短暂冷却后可以再次伤害
                            setTimeout(() => { if(b.hits) b.hits.delete(e); }, 300);
                        }
                    }
                    
                    if (b.life <= 0 && b.target) {
                        b.state = 'fire';
                        // v0.18.0: 使用敌人中心点计算方向
                        const targetCx = b.target.cx || b.target.x;
                        const targetCy = b.target.cy || (b.target.y - (b.target.size || 24));
                        const angle = Math.atan2(targetCy - b.y, targetCx - b.x);
                        b.vx = Math.cos(angle) * b.speed;
                        b.vy = Math.sin(angle) * b.speed;
                    }
                    return true;
                }
                // fire 状态下正常移动
                break;
        }
        
        // 更新位置
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.life -= dt;
        
        if (b.life <= 0) {
            if (subtype === 'explode') {
                // 爆炸AOE
                this.explosionDamage(b.x, b.y, b.explodeRadius, b.dmg, stats);
            }
            return false;
        }
        
        // v0.16.1 fix: 确保 hits 存在
        if (!b.hits) {
            b.hits = new Set();
        }
        
        // v0.22: 子弹碰撞检测 - 碰撞体积与视觉特效一致
        // 根据子弹类型设置碰撞半径，与视觉特效大小匹配
        let bulletRadius = 8; // 默认子弹半径，与视觉效果匹配
        if (b.subtype === 'explode') {
            bulletRadius = b.explodeRadius || 80; // 爆炸子弹使用爆炸范围
        } else if (b.subtype === 'homing' || b.subtype === 'poison_homing') {
            bulletRadius = 10; // 追踪子弹稍大
        } else if (b.subtype === 'boomerang') {
            bulletRadius = 15; // 回旋镖更大
        } else if (b.subtype === 'orbit_proj') {
            bulletRadius = 12; // 环绕投射物
        } else if (b.type === 'laser_beam' || b.isLaser) {
            bulletRadius = b.radius || 20; // v0.22: 激光使用子弹定义的半径（默认20）
        }
        for (const e of enemies) {
            if (e.hp <= 0 || !b.hits || b.hits.has(e)) continue;
            // v0.18.0: 使用增强的椭圆碰撞检测，考虑子弹大小
            if (e.intersectsBullet(b.x, b.y, bulletRadius)) {
                b.hits.add(e);
                
                if (subtype === 'explode') {
                    this.explosionDamage(b.x, b.y, b.explodeRadius, b.dmg, stats);
                    return false;
                } else {
                    this.applyDamage(e, b.dmg, stats, b);
                    if (b.slow) e.slowTimer = 1;
                    if (b.poison) e.applyPoison(b.poison, 3);
                    
                    // v0.16.1 fix: 修复弹跳和穿透逻辑
                    let shouldDestroy = false;
                    
                    if (b.bouncesLeft > 0) {
                        // 弹跳逻辑
                        b.bouncesLeft--;
                        // 寻找新目标
                        let newTarget = null;
                        let minDist = 200;
                        for (const other of enemies) {
                            if (other.hp <= 0 || other === e) continue;
                            const d = dist(b.x, b.y, other.x, other.y);
                            if (d < minDist) {
                                minDist = d;
                                newTarget = other;
                            }
                        }
                        if (newTarget) {
                            // v0.18.0: 使用中心点计算弹跳方向
                            const angle = Math.atan2(newTarget.cy - b.y, newTarget.cx - b.x);
                            const spd = Math.sqrt(b.vx*b.vx + b.vy*b.vy);
                            b.vx = Math.cos(angle) * spd;
                            b.vy = Math.sin(angle) * spd;
                            b.hits.clear();
                        } else {
                            shouldDestroy = true;
                        }
                    } else {
                        shouldDestroy = true;
                    }
                    
                    // 检查穿透
                    if (shouldDestroy) {
                        if (b.pierce > 0) {
                            b.pierce--;
                            b.hits.clear(); // 穿透后清除已命中记录
                        } else {
                            return false;
                        }
                    }
                }
            }
        }
        
        return true;
    }
    
    // 爆炸范围伤害
    explosionDamage(x, y, radius, dmg, stats) {
        this.particles.explosion(x, y, '#f80', 20);
        const enemies = this.curRoom.getActiveEnemies ? this.curRoom.getActiveEnemies() : this.curRoom.enemies;
        for (const e of enemies) {
            if (e.hp <= 0) continue;
            // v0.17.1: 使用贴图范围与爆炸范围相交检测
            if (e.intersectsCircle(x, y, radius)) {
                this.applyDamage(e, dmg, stats, {});
            }
        }
    }
    
    // 应用伤害 - v0.16.1优化：修复伤害计算和空值保护
    applyDamage(e, dmg, stats, bullet) {
        if (!e || e.hp <= 0) return false;
        
        // v0.16.1 fix: 确保伤害为有效数字
        let totalDmg = (typeof dmg === 'number' && dmg > 0) ? dmg : 1;
        
        // v0.16.1 fix: 伤害加成改为百分比形式
        if (stats && stats.fireDmg) totalDmg *= (1 + stats.fireDmg);
        if (stats && stats.thunderDmg && Math.random() < 0.3) totalDmg *= (1 + stats.thunderDmg);
        
        // 确保伤害为整数
        totalDmg = Math.floor(totalDmg);
        
        const killed = e.takeDamage(totalDmg, stats || {});
        
        if (stats && stats.poisonDmg && e.applyPoison) e.applyPoison(stats.poisonDmg, 3);
        // v0.18.4 fix: 处理healOnHit效果
        if (stats && stats.healOnHit && this.player) {
            this.player.hp = Math.min(this.player.maxHp, this.player.hp + stats.healOnHit);
        }
        // v0.18.4 fix: 处理lifeSteal效果（根据造成伤害回血）
        if (stats && stats.lifeSteal && this.player && totalDmg > 0) {
            const healAmount = Math.floor(totalDmg * stats.lifeSteal);
            if (healAmount > 0) {
                this.player.hp = Math.min(this.player.maxHp, this.player.hp + healAmount);
            }
        }
        
        if (killed) {
            e.hp = 0;

            // v0.16.3: 所有怪物掉落物抛物线爆炸效果
            this.spawnExplosiveDrops(e);
            
            // v0.17.4 fix: Boss (isBoss/tier 4) 和 T3 小Boss 都掉落
            if (e.isBoss || e.tier >= 3) {
                // Boss掉落武器选择箱
                this.spawnWeaponChoiceChestAt(e.cx, e.cy);
            } else if (Math.random() < 0.005) {
                this.spawnHeartAt(e.cx, e.cy);
            }
            
            this.particles.explosion(e.cx, e.cy, e.color || '#f44', 25);
            this.particles.sparkle(e.cx, e.cy - 10, '#fc0', 8);
            
            // v0.16.1 fix: 添加 bullet 空值检查
            if (this.bloodStains && this.curRoom && bullet) {
                const bulletAngle = (bullet.vx !== undefined) ? Math.atan2(bullet.vy || 0, bullet.vx) : 0;
                this.bloodStains.addStain(e.x, e.y, e.color, e.isBoss, this.curRoom, bulletAngle, e.type);
            }
            
            const enemyType = e.isBoss ? 'boss' : (e.tier >= 3) ? 'elite' : 'normal';
            this.scoreManager.onKillEnemy(enemyType);
            this.particles.burst(e.cx, e.cy, e.color, 8);  // v0.16.3: 使用中心点
            this.sounds.play('kill');
        } else {
            this.sounds.play('hit');
        }
    }
    
    // ============================================================
    // v0.17.0 - 精细武器视觉效果绘制函数
    // ============================================================
    
    // v0.18.0: 重写近战斩击效果 - 真实武器挥动动画
    drawMeleeEffect(b, pos, time, zoom = 1) {
        const ctx = this.ctx;
        ctx.save();
        ctx.translate(pos.x, pos.y);
        
        const worldRange = b.range || 150;
        const screenRadius = worldRange * zoom;
        // 生命周期 0.25s，计算进度 (0-1)
        const progress = 1 - (b.life / 0.25);
        
        if (b.subtype === 'circle') {
            // ===== 圆形攻击（镰刀）- 3把镰刀旋转挥割 =====
            const bladeCount = 3;
            const rotOffset = time * 15; // 基础旋转
            
            for (let i = 0; i < bladeCount; i++) {
                // 每把镰刀的角度偏移
                const baseAngle = rotOffset + (i * Math.PI * 2 / bladeCount);
                // 动画挥割角度（带淀积效果）
                const swingAngle = Math.sin(progress * Math.PI) * 0.8;
                const currentAngle = baseAngle + swingAngle;
                
                // 镰刀刃长度
                const bladeLength = screenRadius * 0.85;
                const bladeWidth = 8 * zoom;
                
                // 刀柄位置（靠近中心）
                const handleDist = screenRadius * 0.15;
                const tipX = Math.cos(currentAngle) * bladeLength;
                const tipY = Math.sin(currentAngle) * bladeLength;
                const handleX = Math.cos(currentAngle) * handleDist;
                const handleY = Math.sin(currentAngle) * handleDist;
                
                // 1. 刀光残影（挥动轨迹）
                const trailAlpha = (1 - progress) * 0.4;
                ctx.strokeStyle = b.color;
                ctx.lineWidth = bladeWidth * 1.5;
                ctx.globalAlpha = trailAlpha;
                ctx.beginPath();
                ctx.arc(0, 0, (handleDist + bladeLength) / 2, 
                    currentAngle - swingAngle * 0.5, currentAngle + 0.2);
                ctx.stroke();
                
                // 2. 镰刀本体（弧形刀刃）
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = bladeWidth;
                ctx.globalAlpha = 0.9 * (b.life / 0.25);
                ctx.lineCap = 'round';
                
                // 刀刃主体
                ctx.beginPath();
                ctx.moveTo(handleX, handleY);
                // 添加微弧形弯曲
                const midX = Math.cos(currentAngle + 0.1) * (bladeLength * 0.7);
                const midY = Math.sin(currentAngle + 0.1) * (bladeLength * 0.7);
                ctx.quadraticCurveTo(midX, midY, tipX, tipY);
                ctx.stroke();
                
                // 3. 刀锋亮光
                ctx.strokeStyle = b.color;
                ctx.lineWidth = bladeWidth * 0.5;
                ctx.globalAlpha = 1.0 * (b.life / 0.25);
                ctx.beginPath();
                ctx.moveTo(handleX, handleY);
                ctx.lineTo(tipX, tipY);
                ctx.stroke();
                
                // 4. 刀尖光点
                ctx.fillStyle = '#ffffff';
                ctx.globalAlpha = (0.8 + Math.sin(time * 20) * 0.2) * (b.life / 0.25);
                ctx.beginPath();
                ctx.arc(tipX, tipY, 3 * zoom, 0, Math.PI * 2);
                ctx.fill();
            }
            
            // 旋转时的气流效果
            if (progress < 0.5) {
                const ringAlpha = (0.5 - progress) * 0.3;
                ctx.strokeStyle = b.color;
                ctx.lineWidth = 1 * zoom;
                ctx.globalAlpha = ringAlpha;
                ctx.beginPath();
                ctx.arc(0, 0, screenRadius * (0.3 + progress), 0, Math.PI * 2);
                ctx.stroke();
            }
            
        } else {
            // ===== 弧形攻击（鞭子/斧头）- 单次弧线挥割 =====
            const arcAngle = (b.arcAngle || 90) * Math.PI / 180;
            // 挥动从一侧到另一侧
            const startAngle = b.angle - arcAngle / 2;
            const endAngle = b.angle + arcAngle / 2;
            const currentAngle = startAngle + (endAngle - startAngle) * progress;
            
            // 鞭子/斧头参数
            const weaponLength = screenRadius * 0.9;
            const weaponWidth = 6 * zoom;
            
            // 1. 武器挥动轨迹（多重残影）
            for (let i = 0; i < 5; i++) {
                const trailProgress = Math.max(0, progress - i * 0.08);
                if (trailProgress <= 0) continue;
                
                const trailAngle = startAngle + (endAngle - startAngle) * trailProgress;
                const trailAlpha = (1 - i * 0.2) * 0.5 * (b.life / 0.25);
                const trailLength = weaponLength * (0.8 + Math.sin(trailProgress * Math.PI) * 0.2);
                
                const tx = Math.cos(trailAngle) * trailLength;
                const ty = Math.sin(trailAngle) * trailLength;
                
                // 轨迹粒子效果
                ctx.strokeStyle = b.color;
                ctx.lineWidth = weaponWidth * (1 - i * 0.15);
                ctx.globalAlpha = trailAlpha;
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.lineTo(tx, ty);
                ctx.stroke();
            }
            
            // 2. 当前武器位置
            const wx = Math.cos(currentAngle) * weaponLength;
            const wy = Math.sin(currentAngle) * weaponLength;
            
            // 武器主体
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = weaponWidth;
            ctx.globalAlpha = 0.95 * (b.life / 0.25);
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(wx, wy);
            ctx.stroke();
            
            // 武器光泽
            ctx.strokeStyle = b.color;
            ctx.lineWidth = weaponWidth * 0.6;
            ctx.globalAlpha = 1.0 * (b.life / 0.25);
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(wx, wy);
            ctx.stroke();
            
            // 3. 攻击弧线特效（当挥到中间时最亮）
            const midProgress = 1 - Math.abs(progress - 0.5) * 2; // 0-1-0
            if (midProgress > 0.3) {
                const arcWidth = screenRadius * Math.sin(arcAngle / 2);
                ctx.strokeStyle = b.color;
                ctx.lineWidth = 2 * zoom;
                ctx.globalAlpha = midProgress * 0.6 * (b.life / 0.25);
                
                // 绘制弧形刀光
                ctx.beginPath();
                ctx.arc(0, 0, screenRadius * 0.85, 
                    currentAngle - 0.3, currentAngle + 0.3);
                ctx.stroke();
            }
            
            // 4. 击中闪光（只在挥动开始时）
            if (progress < 0.2) {
                const flashAlpha = (0.2 - progress) * 2;
                ctx.fillStyle = '#ffffff';
                ctx.globalAlpha = flashAlpha;
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.arc(0, 0, screenRadius * 0.3, startAngle, endAngle);
                ctx.closePath();
                ctx.fill();
            }
        }
        
        ctx.restore();
    }
    
    // 追踪弹效果 - 旋转核心+尾迹点 - v0.17.1: 添加zoom支持
    drawHomingEffect(b, pos, time, zoom = 1) {
        const ctx = this.ctx;
        ctx.save();
        ctx.translate(pos.x, pos.y);
        
        // v0.18.0: 反色描边
        const outlineColor = this.getContrastingColor(b.color);
        
        // 外发光环
        ctx.fillStyle = b.color;
        ctx.globalAlpha = 0.3;
        ctx.beginPath();
        ctx.arc(0, 0, 12 * zoom, 0, Math.PI * 2);
        ctx.fill();
        
        // 核心 - 双层旋转
        const rot = time * 8;
        
        // 外层菱形
        ctx.fillStyle = b.color;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        for (let i = 0; i < 4; i++) {
            const angle = rot + (i * Math.PI / 2);
            const r = (i % 2 === 0 ? 6 : 3) * zoom;
            ctx.lineTo(Math.cos(angle) * r, Math.sin(angle) * r);
        }
        ctx.closePath();
        ctx.fill();
        
        // v0.18.0: 反色描边
        ctx.strokeStyle = outlineColor;
        ctx.lineWidth = 1.5 * zoom;
        ctx.globalAlpha = 0.7;
        ctx.stroke();
        
        // 内核心
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 1.0;
        ctx.beginPath();
        ctx.arc(0, 0, 2 * zoom, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.restore();
    }
    
