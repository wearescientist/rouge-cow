                    // 检查是否可以进化成超武

                    this.checkWeaponEvolution(existingIdx);

                }

            } else if (this.weapons.length < 6) {

                // 添加新武器

                this.weapons.push(new Weapon(option.key, 1));

                this.particles.burst(this.player.x, this.player.y, '#4f4', 15);

                // v0.17.2: 移除调试日志
