class ItemManager {

    constructor(player) {

        this.player = player;

        this.owned = {};

        this.cache = null;

        this.dirty = true;

    }



    add(id) {
        const item = ITEMS[id];
        if (!item) return false;
        
        // v0.18.4 fix: 道具池机制，不可重复获取
        if (this.owned[id]) {
            // 已拥有该道具，不可再次获取
            return false;
        }
        
        this.owned[id] = 1; // 只记录是否拥有，不叠加数量
        this.dirty = true;
        
        // 立即应用maxHp效果
        if (item.effect === 'maxHp') {
            this.player.maxHp += item.value;
            this.player.hp += item.value;
