function getItemPrice(itemId) {
    const item = ITEMS[itemId];
    if (!item) return 300;
    const basePrice = (item.price || 50) * 3; // v0.9.5 - 商店售价×3
    const variance = basePrice * 0.2;
    return Math.floor(basePrice + rand(-variance, variance));
}

