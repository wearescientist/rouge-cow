    // 闪电效果 - 折线光线 - v0.17.1: 添加zoom支持
    drawLightningEffect(b, pos, time, zoom = 1) {
        const ctx = this.ctx;
        ctx.save();
        ctx.translate(pos.x, pos.y);
        
        ctx.strokeStyle = b.color;
        ctx.lineWidth = 2 * zoom;
        ctx.globalAlpha = 0.9;
        
        // 主光线 - 从中心向四周放射
        for (let r = 0; r < 4; r++) {
            const baseAngle = (r * Math.PI / 2) + time * 10;
            ctx.beginPath();
            ctx.moveTo(0, 0);
            let cx = 0, cy = 0;
            for (let i = 0; i < 3; i++) {
                cx += (Math.cos(baseAngle) * 5 + (Math.random() - 0.5) * 6) * zoom;
                cy += (Math.sin(baseAngle) * 5 + (Math.random() - 0.5) * 6) * zoom;
                ctx.lineTo(cx, cy);
            }
            ctx.stroke();
        }
        
        // 中心闪光
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.arc(0, 0, 2 * zoom, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.restore();
