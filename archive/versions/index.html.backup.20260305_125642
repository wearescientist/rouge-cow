    // 吸血鬼幸存者风格：4选1升级选择界面（2武器+2被动）
    openLevelUpSelect() {
        this.levelUpOpen = true;
        this.activeUIWindow = 'levelUp'; // v0.22: 设为活动窗口
        this.levelUpOptions = [];
        
        // 升级特效 - v0.16.3: 使用中心点
        this.particles.explosion(this.player.cx, this.player.cy, '#ff0', 40);
        this.particles.sparkle(this.player.cx, this.player.cy, '#fff', 15);
        
        // 生成2个武器选项
        // 优先选择已拥有但未满级的武器
        const ownedWeapons = this.weapons.filter(w => !w.isSuper && w.canLevelUp()).map(w => w.baseKey);
        
        // 获取已拥有的武器key（包括超武的原武器）
        const ownedKeys = new Set();
        for (const w of this.weapons) {
            if (w.isSuper) {
                // 超武：记录超武本身和原武器
                ownedKeys.add(w.baseKey);
                if (w.originKey) ownedKeys.add(w.originKey);
            } else {
                ownedKeys.add(w.baseKey);
            }
        }
        
        const availableNewWeapons = Object.keys(WEAPONS).filter(key => {
            return !ownedKeys.has(key); // 排除已拥有的（包括超武原武器）
        });
        
        // 第一个武器：优先选已拥有的（如果有）
        if (ownedWeapons.length > 0) {
            const key = ownedWeapons[Math.floor(Math.random() * ownedWeapons.length)];
            const existing = this.weapons.find(w => w.baseKey === key);
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: false,
                level: existing.level + 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
            // 从ownedWeapons中移除已选择的
            const idx = ownedWeapons.indexOf(key);
            if (idx > -1) ownedWeapons.splice(idx, 1);
        } else if (availableNewWeapons.length > 0) {
            // 没有已拥有的武器，选新武器
            const idx = Math.floor(Math.random() * availableNewWeapons.length);
            const key = availableNewWeapons.splice(idx, 1)[0];
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: true,
                level: 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
        }
        
        // 第二个武器：从剩余的可用武器中选
        const remainingWeapons = [...ownedWeapons, ...availableNewWeapons];
        if (remainingWeapons.length > 0) {
            const idx = Math.floor(Math.random() * remainingWeapons.length);
            const key = remainingWeapons.splice(idx, 1)[0];
            const existing = this.weapons.find(w => w.baseKey === key);
            this.levelUpOptions.push({
                type: 'weapon',
                key: key,
                isNew: !existing,
                level: existing ? existing.level + 1 : 1,
                maxLevel: WEAPONS[key].maxLevel,
                data: WEAPONS[key]
            });
        }
        
        // 生成2个被动选项，显示可与哪个武器合成超武
        const availablePassives = Object.keys(PASSIVES).filter(key => {
            const level = this.passives.getLevel(key);
            const maxLevel = PASSIVES[key].maxLevel;
            return level < maxLevel; // 未满级的被动
        });
        
        // 查找被动对应的超武合成信息 - v0.17.1 fix: 添加安全校验
        const getSuperWeaponInfo = (passiveKey) => {
            for (const [weaponKey, evo] of Object.entries(WEAPON_EVOLUTIONS)) {
                if (evo.requires === passiveKey) {
                    const weapon = this.weapons.find(w => w.baseKey === weaponKey && !w.isSuper);
                    // v0.17.1 fix: 检查武器定义是否存在
                    const weaponCfg = WEAPONS[weaponKey];
                    if (!weaponCfg) {
                        console.warn(`[getSuperWeaponInfo] Weapon ${weaponKey} not found in WEAPONS`);
                        continue;
                    }
                    return {
                        weaponName: weaponCfg.name,
                        superName: evo.name,
                        owned: !!weapon,
                        level: weapon ? weapon.level : 0,
                        canEvolve: weapon && weapon.level >= 8
                    };
                }
            }
            return null;
        };
        
        for (let i = 0; i < 2 && availablePassives.length > 0; i++) {
            const idx = Math.floor(Math.random() * availablePassives.length);
            const key = availablePassives.splice(idx, 1)[0];
            const currentLevel = this.passives.getLevel(key);
            const superInfo = getSuperWeaponInfo(key);
            
            this.levelUpOptions.push({
                type: 'passive',
                key: key,
                level: currentLevel + 1,
                maxLevel: PASSIVES[key].maxLevel,
                superInfo: superInfo,
                data: PASSIVES[key]

            });

        }

        

        // v0.17.2: 移除调试日志
        // console.log('升级选择界面已打开', this.levelUpOptions);

    }

    

