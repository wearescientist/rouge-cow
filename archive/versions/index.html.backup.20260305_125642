    // 生成环绕物 - v0.18.0 fix: 防止无限叠加
    spawnOrbitals(b) {
        if (!this.orbitals) this.orbitals = [];
        // v0.18.0 fix: 移除同颜色（同武器类型）的旧环绕物，防止无限叠加
        this.orbitals = this.orbitals.filter(orb => orb.color !== b.color);
        for (let i = 0; i < b.count; i++) {
            this.orbitals.push({
                angle: (Math.PI * 2 / b.count) * i,
                speed: 2,
                radius: b.range,
                dmg: b.dmg,
                life: b.duration,
                hits: new Set(),
                color: b.color,
                icon: b.icon
            });
        }
    }
    
    // v0.18.3: 生成永久环绕物（超武专用）
    spawnPermanentOrbitals(cfg) {
        if (!this.orbitals) this.orbitals = [];
        // 移除同类型的旧永久环绕物
        this.orbitals = this.orbitals.filter(orb => !(orb.permanent && orb.color === cfg.color));
        const count = cfg.count || 6;
        for (let i = 0; i < count; i++) {
            this.orbitals.push({
                angle: (Math.PI * 2 / count) * i,
                speed: cfg.rotationSpeed || 3,
                radius: cfg.range,
                dmg: cfg.dmg,
                life: Infinity, // 永久存在
                permanent: true, // 标记为永久环绕物
                hits: new Set(),
                color: cfg.color,
                icon: cfg.icon,
                glow: true // 发光特效
            });
        }
    }
    
    // 更新环绕物 - v0.15.0优化：添加空值保护
    updateOrbitals(dt, enemies, stats) {
        if (!this.orbitals || !this.player) return;
        
        for (let i = this.orbitals.length - 1; i >= 0; i--) {
            const orb = this.orbitals[i];
            if (!orb) {
                this.orbitals.splice(i, 1);
                continue;
            }
            
            orb.angle += (orb.speed || 2) * dt;
            
            // v0.18.3: 永久环绕物不减少生命
            if (!orb.permanent) {
                orb.life -= dt;
                if (orb.life <= 0) {
                    this.orbitals.splice(i, 1);
                    continue;
                }
            }
            
            // 计算位置 - v0.16.3: 使用中心点
            const radius = orb.radius || 80;
            const ox = this.player.cx + Math.cos(orb.angle) * radius;
            const oy = this.player.cy + Math.sin(orb.angle) * radius;
            
            // v0.18.2 fix: 环绕物伤害范围与视觉一致 - 整个旋转路径都有伤害
            if (enemies && Array.isArray(enemies)) {
                for (const e of enemies) {
                    if (!e || e.hp <= 0 || !orb.hits) continue;
                    if (orb.hits.has(e)) continue;
                    // v0.18.2: 使用环绕轨迹半径检测，整个圆周范围内的敌人都会受伤
                    const distToPlayer = Math.sqrt((e.cx - this.player.cx)**2 + (e.cy - this.player.cy)**2);
                    const orbRadius = orb.radius || 80;
                    // 允许±30像素的误差范围
                    if (Math.abs(distToPlayer - orbRadius) < 30 + (e.size || 24) * 0.5) {
                        orb.hits.add(e);
                        this.applyDamage(e, orb.dmg || 10, stats || {}, {});
                        // 环绕物可以重复伤害，但有个短暂冷却
                        setTimeout(() => { if(orb && orb.hits) orb.hits.delete(e); }, 300);
                    }
                }
            }
        }
    }

    

