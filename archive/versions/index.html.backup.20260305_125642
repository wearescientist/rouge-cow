            // v0.18.0 fix: 添加被动后检查所有武器是否可以进化
            for (let i = 0; i < this.weapons.length; i++) {
                this.checkWeaponEvolution(i);
            }

        }

        

        this.closeLevelUpSelect();

    }

    

    // 检查武器是否可以进化成超武

    // v0.22: 检查武器是否可以进化成超武（8级武器 + 1级被动）
    checkWeaponEvolution(weaponIdx) {
        const weapon = this.weapons[weaponIdx];
        if (!weapon || weapon.isSuper) return;
        
        // v0.22: 武器必须8级
        if (weapon.level < 8) return;
        
        // v0.22: 检查是否有对应被动（只需1级）
        const evo = WEAPON_EVOLUTIONS[weapon.baseKey];
        if (!evo) return;
        if (!this.passives.has(evo.requires)) return;

        

        // 可以进化！

        // v0.17.2: 移除调试日志
        // console.log(`武器${weapon.cfg.name}可以进化成${evo.name}！`);

        

        // 进化武器

        weapon.evolveToSuper(evo.result);
        // 注意：evolveToSuper内部已处理环绕类超武的初始化

        this.particles.burst(this.player.cx, this.player.cy, '#f0f', 50);  // v0.16.3: 使用中心点

        this.sounds.play('evolve');

        // v0.17.2: 移除调试日志
