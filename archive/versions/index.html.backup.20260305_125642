    // 返回主菜单（重新开始）

    returnToMainMenu() {

        // 立即停止游戏循环

        this.paused = true;

        

        // v0.22: 清理通关动画状态
        this.credits = null;

        

        // 设置重启标志，防止在此期间触发endGame

        this.isRestarting = true;

        

        // 开启无敌模式，防止重启期间受到伤害

        this.godMode = true;

        

        // 重置游戏状态

        this.showResultScreen = false;

        this.gameResult = null;

        this.gameResultData = null;

        this.state = 'menu';

        this.scoreManager.isPlaying = false;

        

        // 隐藏游戏布局，显示故事界面

        const mainLayout = document.getElementById('mainLayout');

        mainLayout.classList.remove('active');

        // 清除可能设置的内联样式，避免影响下次显示

        mainLayout.style.display = '';

        document.getElementById('topScoreBar').style.display = 'none';

        document.getElementById('weaponSelect').style.display = 'none';  // 隐藏武器选择界面

        document.getElementById('story').style.display = 'block';

        

        // 重新初始化游戏

        this.restartGame();

    }

    

    // 重新开始游戏

    restartGame() {
        // 重置地图数据
        this.curRoom = null;
        this.allRooms = null;
        
        // 重置武器选择标志
        this._weaponSelecting = false;

        // 清理上一次游戏的资源
        this.destroy();

        

        // 设置重启标志，防止drawUI在此期间触发endGame

        this.isRestarting = true;

        

        // 重置状态

        this.state = 'menu';

