    // 添加武器
    debugAddWeapon() {
        const select = document.getElementById('debugWeaponSelect');
        const key = select?.value;
        if (!key) return;
        // 检查是否已有此武器
        const existing = this.weapons.find(w => w.baseKey === key);
        if (existing) {
            this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '已有此武器!', {color: '#f44', size: 14, life: 1});
            return;
        }
        if (this.weapons.length >= 6) {
            this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '武器栏满!', {color: '#f44', size: 14, life: 1});
            return;
        }
        this.weapons.push(new Weapon(key, 1));
        this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, `+ ${WEAPONS[key]?.name || key}`, {color: '#4f4', size: 14, life: 1.5});
    }
    
    // 升级武器
    debugUpgradeWeapon() {
        const select = document.getElementById('debugWeaponSelect');
        const key = select?.value;
        if (!key) return;
        const weaponIdx = this.weapons.findIndex(w => w.baseKey === key);
        if (weaponIdx < 0) {
            this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '没有此武器!', {color: '#f44', size: 14, life: 1});
            return;
        }
        const weapon = this.weapons[weaponIdx];
        if (weapon.level >= weapon.maxLevel) {
            this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '已满级!', {color: '#f44', size: 14, life: 1});
            return;
        }
        weapon.levelUp();
        // v0.18.4 fix: 升级后检查进化
        this.checkWeaponEvolution(weaponIdx);
        this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, `${weapon.cfg.name} Lv.${weapon.level}!`, {color: '#48f', size: 14, life: 1.5});
    }
    
    // 武器满级
    debugMaxWeapon() {
        const select = document.getElementById('debugWeaponSelect');
        const key = select?.value;
        if (!key) return;
        let weaponIdx = this.weapons.findIndex(w => w.baseKey === key);
        // 如果没有则添加
        if (weaponIdx < 0) {
            if (this.weapons.length >= 6) {
                this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '武器栏满!', {color: '#f44', size: 14, life: 1});
                return;
            }
            const weapon = new Weapon(key, 1);
            this.weapons.push(weapon);
            weaponIdx = this.weapons.length - 1;
        }
        // 升到满级
        const weapon = this.weapons[weaponIdx];
        while (weapon.level < weapon.maxLevel) {
            weapon.levelUp();
        }
        // v0.18.4 fix: 满级后检查进化
        this.checkWeaponEvolution(weaponIdx);
        this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, `${weapon.cfg.name} 满级!`, {color: '#a4f', size: 14, life: 1.5});
    }
    
    // 添加被动
    debugAddPassive() {
        const select = document.getElementById('debugPassiveSelect');
        const key = select?.value;
        if (!key) return;
        const current = this.passives.getLevel(key);
        const max = PASSIVES[key]?.maxLevel || 5;
        if (current >= max) {
            this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, '被动已满级!', {color: '#f44', size: 14, life: 1});
            return;
        }
        this.passives.add(key);
        this.damageNumbers.spawn(this.player.cx, this.player.cy - 40, `+ ${PASSIVES[key]?.name || key} Lv.${current + 1}`, {color: '#4f4', size: 14, life: 1.5});
        // 检查进化
        for (let i = 0; i < this.weapons.length; i++) {
            this.checkWeaponEvolution(i);
        }
    }
    
    // 被动满级
    debugMaxPassive() {
        const select = document.getElementById('debugPassiveSelect');
