        if (!this.curRoom || this.curRoom.type !== 'shop') return;
        
        const basePrice = 10;
        const refreshPrice = basePrice * Math.pow(2, this.shopRefreshCount);
        
        if (this.player.gold < refreshPrice) {
            // v0.17.2: 移除调试日志
            // console.log('金币不足，无法刷新');
            return;
        }
        
        this.player.gold -= refreshPrice;
        this.shopRefreshCount++;
        
        // 重新生成商店物品
        const itemIds = Object.keys(ITEMS).map(Number);
        const selected = [];
        while (selected.length < 3 && itemIds.length > 0) {
            const idx = Math.floor(Math.random() * itemIds.length);
            const itemId = itemIds.splice(idx, 1)[0];
            const item = ITEMS[itemId];
            if (item) {
                selected.push({
                    id: itemId,
                    icon: item.icon,
                    name: item.name,
                    desc: item.desc,
                    price: getItemPrice(itemId),
                    rarity: item.rarity
                });
