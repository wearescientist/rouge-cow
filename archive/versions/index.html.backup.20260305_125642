            }

        } else if (option.type === 'passive') {

            // 添加或升级被动

            const isNew = this.passives.getLevel(option.key) === 0;

            this.passives.add(option.key);

            this.particles.burst(this.player.cx, this.player.cy, '#48f', 15);  // v0.16.3: 使用中心点

            // v0.17.2: 移除调试日志
