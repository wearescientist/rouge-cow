        const option = this.levelUpOptions[index];

        

        if (option.type === 'weapon') {

            const existingIdx = this.weapons.findIndex(w => w.baseKey === option.key && !w.isSuper);

            if (existingIdx >= 0) {

                // 升级现有武器

                const weapon = this.weapons[existingIdx];

