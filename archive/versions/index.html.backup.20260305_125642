    // 更新宝箱抽奖动画
    updateBossChestLottery(dt) {
        const lottery = this.bossChestLottery;
        if (!lottery || !lottery.active) return;
        
        // 更新粒子
        lottery.particles = lottery.particles.filter(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.life -= dt;
            p.vy += 0.3;
            return p.life > 0;
        });
        
        // 生成背景粒子
        if (Math.random() < 0.3) {
            const colors = ['#ffd700', '#ffaa00', '#ff6600', '#ff0066', '#ff00ff'];
            const color = colors[Math.floor(Math.random() * colors.length)];
            lottery.particles.push({
                x: 600 + (Math.random() - 0.5) * 400,
                y: 400 + (Math.random() - 0.5) * 300,
                vx: (Math.random() - 0.5) * 10,
                vy: (Math.random() - 0.5) * 10 - 5,
                life: 1 + Math.random(),
                color: color,
                size: 3 + Math.random() * 5
            });
        }
        
        // 闪烁效果强度
        lottery.glowIntensity += dt * 3;
        
        // 滚动阶段
        if (lottery.phase === 'rolling') {
            lottery.rollProgress += dt * lottery.rollSpeed;
            lottery.rollSpeed += dt * 0.5; // 加速
            
            // 根据结果等级改变背景闪烁速度
            const targetProgress = lottery.resultTier === 5 ? 4 : (lottery.resultTier === 3 ? 3 : 2.5);
            
            if (lottery.rollProgress >= targetProgress) {
                lottery.phase = 'revealing';
                lottery.currentReveal = 0;
                lottery.revealTimer = 0;
                // 播放揭示音效
                this.sounds.play('levelup');
            }
        }
        // 揭示阶段
        else if (lottery.phase === 'revealing') {
            lottery.revealTimer += dt;
            
            // 逐个揭示武器
            const revealInterval = lottery.resultTier === 5 ? 0.4 : (lottery.resultTier === 3 ? 0.6 : 0.8);
            
            if (lottery.currentReveal < lottery.revealedWeapons.length && lottery.revealTimer >= revealInterval) {
                const weapon = lottery.revealedWeapons[lottery.currentReveal];
                weapon.revealed = true;
                
                // 揭示特效
                for (let i = 0; i < 20; i++) {
                    lottery.particles.push({
                        x: 600,
                        y: weapon.targetY,
                        vx: (Math.random() - 0.5) * 15,
                        vy: (Math.random() - 0.5) * 15,
                        life: 1.5,
                        color: '#ffd700',
                        size: 4 + Math.random() * 4
                    });
                }
                
                lottery.currentReveal++;
                lottery.revealTimer = 0;
                this.sounds.play('chest');
            }
            
            // 更新已揭示武器的动画
            lottery.revealedWeapons.forEach((w, i) => {
                if (w.revealed) {
                    w.scale = Math.min(1, w.scale + dt * 3);
                    w.y += (w.targetY - w.y) * dt * 5;
                    w.rotation *= 0.9;
                }
            });
            
            // 全部揭示完成
            if (lottery.currentReveal >= lottery.revealedWeapons.length && lottery.revealTimer > 2) {
                lottery.phase = 'done';
            }
        }
    }
    
    // 绘制宝箱抽奖界面
    drawBossChestLottery(ctx) {
        const lottery = this.bossChestLottery;
        if (!lottery || !lottery.active) return;
        
        const w = ctx.canvas.width;
        const h = ctx.canvas.height;
        const centerX = w / 2;
        const centerY = h / 2;
        
        // 获取等级配置
        const tierConfig = {
            1: { name: '普通', color: '#888888', glow: '#444444', particles: 0.2 },
            3: { name: '稀有', color: '#4488ff', glow: '#2244aa', particles: 0.4 },
            5: { name: '传说', color: '#ff6600', glow: '#ffaa00', particles: 0.8 }
        }[lottery.resultTier];
        
        // 背景渐变
        const bgGradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, Math.max(w, h));
        bgGradient.addColorStop(0, 'rgba(0, 0, 0, 0.95)');
        bgGradient.addColorStop(0.5, `rgba(20, 10, 0, 0.9)`);
        bgGradient.addColorStop(1, 'rgba(0, 0, 0, 0.98)');
        ctx.fillStyle = bgGradient;
        ctx.fillRect(0, 0, w, h);
        
        // 闪烁边框
        const glowAlpha = 0.5 + Math.sin(lottery.glowIntensity) * 0.3;
        const borderGradient = ctx.createLinearGradient(0, 0, w, h);
        borderGradient.addColorStop(0, `rgba(255, 215, 0, ${glowAlpha})`);
        borderGradient.addColorStop(0.5, `rgba(255, 170, 0, ${glowAlpha * 0.5})`);
        borderGradient.addColorStop(1, `rgba(255, 215, 0, ${glowAlpha})`);
        ctx.strokeStyle = borderGradient;
        ctx.lineWidth = 4;
        ctx.strokeRect(10, 10, w - 20, h - 20);
        
        // 标题
        ctx.font = 'bold 48px Arial';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#ffd700';
        ctx.shadowColor = '#ffaa00';
        ctx.shadowBlur = 20;
        ctx.fillText('👑 金色Boss宝箱 👑', centerX, 80);
        ctx.shadowBlur = 0;
        
        // 状态文字
        ctx.font = '24px Arial';
        if (lottery.phase === 'rolling') {
            const dots = '.'.repeat(Math.floor(lottery.glowIntensity * 2) % 4);
            ctx.fillStyle = `rgba(255, 215, 0, ${0.5 + Math.sin(lottery.glowIntensity * 2) * 0.5})`;
            ctx.fillText(`🎲 抽奖中${dots}`, centerX, 130);
            
            // 滚动中的宝箱图标
            const bounce = Math.sin(lottery.glowIntensity * 4) * 10;
            ctx.font = '80px Arial';
            ctx.fillText('📦', centerX, 250 + bounce);
            
            // 滚动数字效果
            ctx.font = '36px Arial';
            ctx.fillStyle = '#ffaa00';
            const rollingNum = Math.floor(Math.random() * 5) + 1;
            ctx.fillText(`? x ${rollingNum}`, centerX, 320);
        }
        else if (lottery.phase === 'revealing') {
            ctx.fillStyle = tierConfig.color;
            ctx.fillText(`✨ ${tierConfig.name}奖励! ✨`, centerX, 130);
            
            // 绘制揭示的武器
            lottery.revealedWeapons.forEach((weapon, i) => {
                if (!weapon.revealed && i > lottery.currentReveal) return;
                
                const y = weapon.revealed ? weapon.y : 350;
                const alpha = weapon.revealed ? 1 : 0.3;
                const scale = weapon.revealed ? weapon.scale : 0.8;
                
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.translate(centerX, y);
                ctx.scale(scale, scale);
                
                // 武器背景框
                const boxGradient = ctx.createLinearGradient(-200, -35, 200, 35);
                boxGradient.addColorStop(0, 'rgba(40, 30, 10, 0.9)');
                boxGradient.addColorStop(0.5, 'rgba(60, 50, 20, 0.95)');
                boxGradient.addColorStop(1, 'rgba(40, 30, 10, 0.9)');
                ctx.fillStyle = boxGradient;
                ctx.fillRect(-200, -35, 400, 70);
                
                // 边框
                ctx.strokeStyle = weapon.revealed ? tierConfig.color : '#666';
                ctx.lineWidth = weapon.revealed ? 3 : 1;
                ctx.strokeRect(-200, -35, 400, 70);
                
                // 武器图标
                ctx.font = '40px Arial';
                ctx.textAlign = 'center';
                ctx.fillStyle = '#fff';
                ctx.fillText(weapon.data.icon || '⚔️', -150, 10);
                
                // 武器名称
                ctx.font = 'bold 24px Arial';
                ctx.textAlign = 'left';
                ctx.fillStyle = weapon.revealed ? '#ffd700' : '#888';
                const nameText = weapon.revealed ? weapon.data.name : '???';
                ctx.fillText(nameText, -100, -8);
                
                // 显示升级信息或新武器标记
                if (weapon.revealed) {
                    ctx.font = 'bold 14px Arial';
                    if (weapon.isUpgrade) {
                        // 已有武器升级
                        const maxLv = weapon.data.maxLevel || 8;
                        ctx.fillStyle = '#4f4';
                        ctx.fillText(`⬆️ Lv.${weapon.currentLevel} → Lv.${Math.min(weapon.currentLevel + 1, maxLv)}`, -100, 12);
                    } else {
                        // 新武器
                        ctx.fillStyle = '#48f';
                        ctx.fillText('🆕 新武器!', -100, 12);
                    }
                } else {
                    ctx.font = '14px Arial';
                    ctx.fillStyle = '#666';
                    ctx.fillText('?????', -100, 15);
                }
                
                // 武器描述
                ctx.font = '12px Arial';
                ctx.fillStyle = weapon.revealed ? '#aaa' : '#666';
                ctx.fillText(weapon.revealed ? (weapon.data.desc || '神秘武器') : '?????', -100, 28);
                
                ctx.restore();
            });
        }
        else if (lottery.phase === 'done') {
            // 完成状态
            ctx.fillStyle = '#ffd700';
            ctx.font = 'bold 32px Arial';
            ctx.fillText(`🎉 获得 ${lottery.resultTier} 个武器! 🎉`, centerX, 130);
            
            // 全部武器展示
            lottery.revealedWeapons.forEach((weapon, i) => {
                const y = weapon.targetY;
                
                ctx.save();
                ctx.translate(centerX, y);
                
                // 发光边框
                ctx.shadowColor = tierConfig.glow;
                ctx.shadowBlur = 15;
                
                // 武器背景框
                const boxGradient = ctx.createLinearGradient(-220, -40, 220, 40);
                boxGradient.addColorStop(0, 'rgba(60, 40, 10, 0.95)');
                boxGradient.addColorStop(0.5, 'rgba(100, 80, 30, 0.98)');
                boxGradient.addColorStop(1, 'rgba(60, 40, 10, 0.95)');
                ctx.fillStyle = boxGradient;
                ctx.fillRect(-220, -40, 440, 80);
                ctx.shadowBlur = 0;
                
                // 金色边框
                ctx.strokeStyle = '#ffd700';
                ctx.lineWidth = 3;
                ctx.strokeRect(-220, -40, 440, 80);
                
                // 武器图标
                ctx.font = '48px Arial';
                ctx.textAlign = 'center';
                ctx.fillStyle = '#fff';
                ctx.fillText(weapon.data.icon || '⚔️', -160, 15);
                
                // 武器名称
                ctx.font = 'bold 28px Arial';
                ctx.textAlign = 'left';
                ctx.fillStyle = '#ffd700';
                ctx.fillText(weapon.data.name, -100, -5);
                
                // 升级/新武器标记
                ctx.font = 'bold 16px Arial';
                if (weapon.isUpgrade) {
                    const maxLv = weapon.data.maxLevel || 8;
                    ctx.fillStyle = '#4f4';
                    ctx.fillText(`⬆️ 升级 Lv.${weapon.currentLevel} → Lv.${Math.min(weapon.currentLevel + 1, maxLv)}`, -100, 20);
                } else {
                    ctx.fillStyle = '#48f';
                    ctx.fillText('🆕 新武器获得!', -100, 20);
                }
                
                // 武器描述
                ctx.font = '14px Arial';
                ctx.fillStyle = '#ccaa66';
                ctx.fillText(weapon.data.desc || '神秘武器', -100, 42);
                
                ctx.restore();
            });
            
            // 提示文字
            ctx.font = '20px Arial';
            ctx.textAlign = 'center';
            ctx.fillStyle = `rgba(255, 255, 255, ${0.5 + Math.sin(lottery.glowIntensity) * 0.5})`;
            ctx.fillText('点击任意位置或按空格键领取奖励', centerX, h - 50);
        }
        
        // 绘制粒子
        lottery.particles.forEach(p => {
            ctx.globalAlpha = Math.min(1, p.life);
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;
    }
    
    selectWeaponBoxOption(index) {
