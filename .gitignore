# Git Ignore for Rogue Cow Game

# Backup files
*.backup*
*.bak
*~

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary scripts (development tools)
analyze_sprites.py
code_check.py
fix_size.py
fix_sprite_center.py
fix_super.py
check_*.py
find_*.py
verify_*.py

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary text files
*.temp
*.tmp
tmp_chrome_profile*/

# Large files (GitHub 100MB limit)
*.zip
*.bundle
index.html.backup*
*.7z
*.tar.gz

# Archives (keep source only)
archive/
versions/

# Large folders (DO NOT commit)
backup/
tools/nodejs/
reports/
# BGM files are kept (WAV format)
# assets/audio/bgm/*.wav
assets/fonts/_vendor/*/sources/
generated_assets/
generated_audio/
videos/
dist/

# Environment
.env
